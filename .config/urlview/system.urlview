macro index \cb |urlview\n
macro pager \cb |urlview\n	
REGEXP (((http|https|ftp|gopher)|mailto)[.:][^ >"\t]*|www\.[-a-z0-9.]+)[^ .,;\t>">\):]
COMMAND xdg-open %s
#COMMAND lynx %s
COMMAND url_handler.sh
