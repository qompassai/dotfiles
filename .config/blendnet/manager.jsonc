{
    "%comment%": "Remove the header _ from the configuration keys to enable them",
    "name": "Arch Linux Blendnet Manager",
    "_auth_user": "$(pass show blendnet/u)",
    "_auth_password": "$(pass show blendnet/p)",
    "_agent_auth_user": "$(pass show blendnet/u)",
    "_agent_auth_password": "$(pass show blendnet/p)",
    "_ip": "$(pass show blendnet/ip)",
    "_internal_ip": "$(pass show blendnet/iip)",
    "_listen_host": "",
    "_listen_port": 8443,
    "_agent_listen_port": 9443,
    "_agent_upload_workers": 4
}
