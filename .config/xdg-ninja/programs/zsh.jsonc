{
    "name": "zsh",
    "files": [
        {
            "path": "$HOME/.zcompcache",
            "movable": true,
            "help": "Set this in your zshrc:\n\n```bash\nzstyle ':completion:*' cache-path \"$XDG_CACHE_HOME\"/zsh/zcompcache\n```\n\nYou must manually create the _$XDG_CACHE_HOME/zsh_ directory if it doesn't exist yet.\n"
        },
        {
            "path": "$HOME/.zcompdump*",
            "movable": true,
            "help": "Set this in your zshrc:\n\n```bash\ncompinit -d \"$XDG_CACHE_HOME\"/zsh/zcompdump-\"$ZSH_VERSION\"\n```\n\nYou must manually create the _$XDG_CACHE_HOME/zsh_ directory if it doesn't exist yet.\n"
        },
        {
            "path": "$HOME/.zhistory",
            "movable": true,
            "help": "Set this in your zshrc:\n\n```bash\nexport HISTFILE=\"$XDG_STATE_HOME\"/zsh/history\n```\n\nYou must manually create the _$XDG_STATE_HOME/zsh_ directory if it doesn't exist yet.\n"
        },
        {
            "path": "$HOME/.histfile",
            "movable": true,
            "help": "Set this in your zshrc:\n\n```bash\nexport HISTFILE=\"$XDG_STATE_HOME\"/zsh/history\n```\n\nYou must manually create the _$XDG_STATE_HOME/zsh_ directory if it doesn't exist yet.\n"
        },
        {
            "path": "$HOME/.zsh_history",
            "movable": true,
            "help": "Set this in your zshrc:\n\n```bash\nexport HISTFILE=\"$XDG_STATE_HOME\"/zsh/history\n```\n\nYou must manually create the _$XDG_STATE_HOME/zsh_ directory if it doesn't exist yet.\n"
        },
        {
            "path": "$HOME/.zlogin",
            "movable": true,
            "help": "Move the file to _\"$XDG_CONFIG_HOME\"/zsh/.zlogin_ and export the following environment variable:\n\n```bash\nexport ZDOTDIR=\"$XDG_CONFIG_HOME\"/zsh\n```\n\nYou can do this in _/etc/zshenv_ (or _/etc/zsh/zshenv_ on some distros).\n"
        },
        {
            "path": "$HOME/.zlogout",
            "movable": true,
            "help": "Move the file to _\"$XDG_CONFIG_HOME\"/zsh/.zlogout_ and export the following environment variable:\n\n```bash\nexport ZDOTDIR=\"$XDG_CONFIG_HOME\"/zsh\n```\n\nYou can do this in _/etc/zshenv_ (or _/etc/zsh/zshenv_ on some distros).\n"
        },
        {
            "path": "$HOME/.zprofile",
            "movable": true,
            "help": "Move the file to _\"$XDG_CONFIG_HOME\"/zsh/.zprofile_ and export the following environment variable:\n\n```bash\nexport ZDOTDIR=\"$XDG_CONFIG_HOME\"/zsh\n```\n\nYou can do this in _/etc/zshenv_ (or _/etc/zsh/zshenv_ on some distros).\n"
        },
        {
            "path": "$HOME/.zshenv",
            "movable": true,
            "help": "Move the file to _\"$XDG_CONFIG_HOME\"/zsh/.zshenv_ and export the following environment variable:\n\n```bash\nexport ZDOTDIR=\"$XDG_CONFIG_HOME\"/zsh\n```\n\nYou can do this in _/etc/zshenv_ (or _/etc/zsh/zshenv_ on some distros).\n"
        },
        {
            "path": "$HOME/.zshrc",
            "movable": true,
            "help": "Move the file to _\"$XDG_CONFIG_HOME\"/zsh/.zshrc_ and export the following environment variable:\n\n```bash\nexport ZDOTDIR=\"$XDG_CONFIG_HOME\"/zsh\n```\n\nYou can do this in _/etc/zshenv_ (or _/etc/zsh/zshenv_ on some distros).\n"
        }
    ]
}

