abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{sbin}/libvirt-dbus
profile libvirt-dbus /{,usr/}{,s}bin/libvirt-dbus flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/bus-system>
  include <abstractions/nameservice-strict>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.libvirt{,.*},
  dbus receive bus=session path=/org/libvirt{,/**}
       interface=org.libvirt{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/libvirt{,/**}
       interface=org.libvirt{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/libvirt{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/libvirt{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/libvirt{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.libvirt{,.*}}"),
  dbus send bus=session path=/org/libvirt{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  include <abstractions/bus/own-system>

  dbus bind bus=system name=org.libvirt{,.*},
  dbus receive bus=system path=/org/libvirt{,/**}
       interface=org.libvirt{,.*}
       peer=(name="@{busname}"),
  dbus send bus=system path=/org/libvirt{,/**}
       interface=org.libvirt{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=system path=/org/libvirt{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=system path=/org/libvirt{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=system path=/org/libvirt{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.libvirt{,.*}}"),
  dbus send bus=system path=/org/libvirt{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  @{sbin}/libvirtd  rpx,
  @{bin}/virtqemud  rpx,

  /usr/share/dbus-1/interfaces/org.libvirt.*.xml r,

  owner @{user_cache_dirs}/libvirt/libvirtd.lock rwk,

  @{run}/user/@{uid}/libvirt/ rw,
  @{run}/user/@{uid}/libvirt/libvirtd.lock rwk,
  @{run}/user/@{uid}/libvirt/virtqemud.lock rwk,

  @{sys}/devices/system/node/ r,
  @{sys}/devices/system/node/node*/meminfo r,

  owner @{PROC}/@{pid}/fd/ r,

  include if exists <local/libvirt-dbus>
}

# vim:syntax=apparmor
