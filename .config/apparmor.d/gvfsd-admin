abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,gvfs/}gvfsd-admin
profile gvfsd-admin /{,usr/}lib{,exec,32,64}/{,gvfs/}gvfsd-admin flags=(complain) {
  include <abstractions/base>

  @{exec_path} mr,

  include if exists <local/gvfsd-admin>
}

# vim:syntax=apparmor
