abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/gnome-control-center-search-provider
profile gnome-control-center-search-provider /{,usr/}lib{,exec,32,64}/gnome-control-center-search-provider flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/bus/org.freedesktop.portal.Desktop>
  include <abstractions/bus/org.gtk.vfs.MountTracker>
  include <abstractions/dconf-write>
  include <abstractions/gnome-strict>
  include <abstractions/graphics>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.gnome.Settings.SearchProvider{,.*},
  dbus receive bus=session path=/org/gnome/Settings/SearchProvider{,/**}
       interface=org.gnome.Settings.SearchProvider{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gnome/Settings/SearchProvider{,/**}
       interface=org.gnome.Settings.SearchProvider{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gnome/Settings/SearchProvider{,/**}
       interface=org.gnome.Shell.SearchProvider2
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gnome/Settings/SearchProvider{,/**}
       interface=org.gnome.Shell.SearchProvider2
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/gnome/Settings/SearchProvider{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gnome/Settings/SearchProvider{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/gnome/Settings/SearchProvider{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.Settings.SearchProvider{,.*}}"),
  dbus send bus=session path=/org/gnome/Settings/SearchProvider{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  owner @{PROC}/@{pid}/cmdline r,

  include if exists <local/gnome-control-center-search-provider>
}

# vim:syntax=apparmor
