abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{sbin}/u-d-c-print-pci-ids
profile u-d-c-print-pci-ids /{,usr/}{,s}bin/u-d-c-print-pci-ids flags=(complain) {
  include <abstractions/base>

  @{exec_path} mr,
  @{sh_path} r,

  include if exists <local/u-d-c-print-pci-ids>
}

# vim:syntax=apparmor
