abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,colord/}colord-session
profile colord-session /{,usr/}lib{,exec,32,64}/{,colord/}colord-session flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.freedesktop.ColorHelper{,.*},
  dbus receive bus=session path=/org/freedesktop/ColorHelper{,/**}
       interface=org.freedesktop.ColorHelper{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/freedesktop/ColorHelper{,/**}
       interface=org.freedesktop.ColorHelper{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/freedesktop/ColorHelper{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/freedesktop/ColorHelper{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/freedesktop/ColorHelper{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.ColorHelper{,.*}}"),
  dbus send bus=session path=/org/freedesktop/ColorHelper{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  include if exists <local/colord-session>
}

# vim:syntax=apparmor
