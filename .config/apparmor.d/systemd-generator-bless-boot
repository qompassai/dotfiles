abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-generators/systemd-bless-boot-generator
profile systemd-generator-bless-boot /{,usr/}lib{,exec,32,64}/systemd/system-generators/systemd-bless-boot-generator  flags=(attach_disconnected,complain) {
  include <abstractions/base>
  include <abstractions/common/systemd>

  @{exec_path} mr,

  @{PROC}/@{pid}/cgroup r,

  include if exists <local/systemd-generator-bless-boot>
}

# vim:syntax=apparmor
