abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/gsd-wwan
profile gsd-wwan /{,usr/}lib{,exec,32,64}/gsd-wwan flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/dconf-write>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.gnome.SettingsDaemon.Wwan{,.*},
  dbus receive bus=session path=/org/gnome/SettingsDaemon/Wwan{,/**}
       interface=org.gnome.SettingsDaemon.Wwan{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gnome/SettingsDaemon/Wwan{,/**}
       interface=org.gnome.SettingsDaemon.Wwan{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/gnome/SettingsDaemon/Wwan{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gnome/SettingsDaemon/Wwan{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/gnome/SettingsDaemon/Wwan{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.SettingsDaemon.Wwan{,.*}}"),
  dbus send bus=session path=/org/gnome/SettingsDaemon/Wwan{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  include if exists <local/gsd-wwan>
}

# vim:syntax=apparmor
