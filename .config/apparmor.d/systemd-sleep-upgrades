abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-sleep/unattended-upgrades
profile systemd-sleep-upgrades /{,usr/}lib{,exec,32,64}/systemd/system-sleep/unattended-upgrades flags=(complain) {
  include <abstractions/base>

  @{exec_path} mr,

  include if exists <local/systemd-sleep-upgrades>
}

# vim:syntax=apparmor
