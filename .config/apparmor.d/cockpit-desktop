abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/cockpit/cockpit-desktop
profile cockpit-desktop /{,usr/}lib{,exec,32,64}/cockpit/cockpit-desktop flags=(complain) {
  include <abstractions/base>

  userns,

  @{exec_path} mr,

  include if exists <local/cockpit-desktop>
}

# vim:syntax=apparmor
