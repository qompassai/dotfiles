abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/avahi-publish @{bin}/avahi-publish-address @{bin}/avahi-publish-service
profile avahi-publish /{{,usr/}bin/avahi-publish,{,usr/}bin/avahi-publish-address,{,usr/}bin/avahi-publish-service} flags=(complain) {
  include <abstractions/base>
  include <abstractions/consoles>

  @{exec_path} mr,

  include if exists <local/avahi-publish>
}


# vim:syntax=apparmor
