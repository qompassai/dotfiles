  abi <abi/4.0>,

  include <abstractions/path>

  @{bin}/**                     pux,
  /opt/*/**                     pux,
  /usr/share/**                 pux,
  /usr/local/bin/**             pux,

  @{brave_path}                 px,
  @{chrome_path}                px,
  @{chromium_path}              px,
  @{firefox_path}               px,
  @{opera_path}                 px,
  @{thunderbird_path}           px,
  @{offices_path}              pux,

  @{user_bin_dirs}/**          pux,

  include if exists <abstractions/app-launcher-user.d>

# vim:syntax=apparmor
