abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/deja-dup/deja-dup-monitor
profile deja-dup-monitor /{,usr/}lib{,exec,32,64}/deja-dup/deja-dup-monitor flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/bus-system>
  include <abstractions/bus/net.hadess.PowerProfiles>
  include <abstractions/bus/org.freedesktop.portal.Desktop>
  include <abstractions/bus/org.gtk.Private.RemoteVolumeMonitor>
  include <abstractions/bus/org.gtk.vfs.Daemon>
  include <abstractions/bus/org.gtk.vfs.MountTracker>
  include <abstractions/dconf-write>

  network netlink raw,

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.gnome.DejaDup.Monitor{,.*},
  dbus receive bus=session path=/org/gnome/DejaDup/Monitor{,/**}
       interface=org.gnome.DejaDup.Monitor{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gnome/DejaDup/Monitor{,/**}
       interface=org.gnome.DejaDup.Monitor{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/gnome/DejaDup/Monitor{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gnome/DejaDup/Monitor{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/gnome/DejaDup/Monitor{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.DejaDup.Monitor{,.*}}"),
  dbus send bus=session path=/org/gnome/DejaDup/Monitor{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/gnome/DejaDup{,/**}
       interface=org.gnome.DejaDup{,.*}
       peer=(name="{@{busname},org.gnome.DejaDup{,.*}}", label=deja-dup),
  dbus (send receive) bus=session path=/org/gnome/DejaDup{,/**}
       interface=org.gtk.Actions
       peer=(name="{@{busname},org.gnome.DejaDup{,.*}}", label=deja-dup),
  dbus (send receive) bus=session path=/org/gnome/DejaDup{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.gnome.DejaDup{,.*}}", label=deja-dup),
  dbus send bus=session path=/org/gnome/DejaDup{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.gnome.DejaDup{,.*}}", label=deja-dup),
  dbus send bus=session path=/org/gnome/DejaDup{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.DejaDup{,.*}}", label=deja-dup),
  dbus receive bus=session path=/org/gnome/DejaDup{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.gnome.DejaDup{,.*}}", label=deja-dup),

  dbus send bus=session path=/org/gnome/DejaDup
       interface=org.gtk.Actions
       member=Activate
       peer=(name=org.gnome.DejaDup),

  dbus send bus=system path=/org/freedesktop/NetworkManager
       interface=org.freedesktop.DBus.Properties
       member=GetAll
       peer=(name=:*, label=NetworkManager),

  @{exec_path} mr,

  @{bin}/chrt       rix,
  @{bin}/ionice     rix,

  /usr/share/glib-2.0/schemas/gschemas.compiled r,

  /var/tmp/ r,
  /tmp/ r,

  include if exists <local/deja-dup-monitor>
}

# vim:syntax=apparmor
