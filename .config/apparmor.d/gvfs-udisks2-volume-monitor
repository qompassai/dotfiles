abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,gvfs/}gvfs-udisks2-volume-monitor
profile gvfs-udisks2-volume-monitor /{,usr/}lib{,exec,32,64}/{,gvfs/}gvfs-udisks2-volume-monitor  flags=(attach_disconnected,complain) {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/bus-system>
  include <abstractions/bus/org.gtk.vfs.MountTracker>
  include <abstractions/dconf-write>
  include <abstractions/devices-usb>
  include <abstractions/disks-read>
  include <abstractions/freedesktop.org>
  include <abstractions/nameservice-strict>

  capability sys_ptrace,

  network inet stream,
  network inet6 stream,
  network netlink raw,

  signal (send) set=(term, kill) peer=mount,

  ptrace (read),

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.gtk.vfs.UDisks2VolumeMonitor{,.*},
  dbus receive bus=session path=/org/gtk/Private/RemoteVolumeMonitor
       interface=org.gtk.vfs.UDisks2VolumeMonitor{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gtk/Private/RemoteVolumeMonitor
       interface=org.gtk.vfs.UDisks2VolumeMonitor{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gtk/Private/RemoteVolumeMonitor
       interface=org.gtk.Private.RemoteVolumeMonitor
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gtk/Private/RemoteVolumeMonitor
       interface=org.gtk.Private.RemoteVolumeMonitor
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/gtk/Private/RemoteVolumeMonitor
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gtk/Private/RemoteVolumeMonitor
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/gtk/Private/RemoteVolumeMonitor
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gtk.vfs.UDisks2VolumeMonitor{,.*}}"),
  dbus send bus=session path=/org/gtk/Private/RemoteVolumeMonitor
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=system path=/org/freedesktop/UDisks2{,/**}
       interface=org.freedesktop.UDisks2{,.*}
       peer=(name="{@{busname},org.freedesktop.UDisks2{,.*}}", label=udisksd),
  dbus (send receive) bus=system path=/org/freedesktop/UDisks2{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.UDisks2{,.*}}", label=udisksd),
  dbus send bus=system path=/org/freedesktop/UDisks2{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.freedesktop.UDisks2{,.*}}", label=udisksd),
  dbus send bus=system path=/org/freedesktop/UDisks2{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.UDisks2{,.*}}", label=udisksd),
  dbus receive bus=system path=/org/freedesktop/UDisks2{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.UDisks2{,.*}}", label=udisksd),

  dbus receive bus=session
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name=:*, label=gnome-shell),

  @{exec_path} mr,

  @{bin}/lsof   rix,

  @{bin}/mount  rpx,
  @{bin}/umount rpx,

  / r,
  /etc/fstab r,

  # Mount points
  @{MOUNTS}/ r,
  @{MOUNTS}/**/ r,
  @{HOME}/**/ r,

  owner @{MOUNTS}/autorun.inf r,

  owner @{desktop_config_dirs}/dconf/user r,

  @{run}/mount/utab r,

        @{PROC}/ r,
        @{PROC}/@{pids}/net/* r,
        @{PROC}/@{pids}/stat r,
        @{PROC}/1/cgroup r,
        @{PROC}/locks r,
  owner @{PROC}/@{pid}/cgroup r,
  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/fdinfo/@{int} r,
  owner @{PROC}/@{pid}/mountinfo r,
  owner @{PROC}/@{pid}/mounts r,

  /dev/dri/card@{int} r,
  /dev/input/event@{int} r,

  include if exists <local/gvfs-udisks2-volume-monitor>
}

# vim:syntax=apparmor
