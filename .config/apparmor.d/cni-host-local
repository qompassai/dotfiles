abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/cni/host-local /opt/cni/bin/host-local
profile cni-host-local /{{,usr/}lib{,exec,32,64}/cni/host-local,opt/cni/bin/host-local} flags=(complain,attach_disconnected){
  include <abstractions/base>

  @{exec_path} mr,

  include if exists <local/cni-host-local>
}

# vim:syntax=apparmor
