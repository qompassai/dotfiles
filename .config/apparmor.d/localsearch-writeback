abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/localsearch-writeback-3
profile localsearch-writeback /{,usr/}lib{,exec,32,64}/localsearch-writeback-3 flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.freedesktop.LocalSearch3.Writeback{,.*},
  dbus receive bus=session path=/org/freedesktop/LocalSearch3/Writeback{,/**}
       interface=org.freedesktop.LocalSearch3.Writeback{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/freedesktop/LocalSearch3/Writeback{,/**}
       interface=org.freedesktop.LocalSearch3.Writeback{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/freedesktop/LocalSearch3/Writeback{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/freedesktop/LocalSearch3/Writeback{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/freedesktop/LocalSearch3/Writeback{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.LocalSearch3.Writeback{,.*}}"),
  dbus send bus=session path=/org/freedesktop/LocalSearch3/Writeback{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  include if exists <local/localsearch-writeback>
}

# vim:syntax=apparmor
