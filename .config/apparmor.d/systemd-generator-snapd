abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-generators/snapd-generator
profile systemd-generator-snapd /{,usr/}lib{,exec,32,64}/systemd/system-generators/snapd-generator  flags=(attach_disconnected,complain) {
  include <abstractions/base>

  @{exec_path} mr,

  @{PROC}/1/mountinfo r,

  include if exists <local/systemd-generator-snapd>
}

# vim:syntax=apparmor
