abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/udev/hdparm
profile udev-hdparm /{,usr/}lib{,exec,32,64}/udev/hdparm flags=(complain) {
  include <abstractions/base>

  @{exec_path} mr,

  @{sh_path}         rix,
  @{bin}/{,e}grep    rix,
  @{bin}/sed         rix,
  @{bin}/udevadm     rpx,

  /etc/hdparm.conf r,

  @{PROC}/cmdline r,
  @{PROC}/mdstat r,

  include if exists <local/udev-hdparm>
}

# vim:syntax=apparmor
