abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/flatpak-oci-authenticator
profile flatpak-oci-authenticator /{,usr/}lib{,exec,32,64}/flatpak-oci-authenticator flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.flatpak.Authenticator.Oci{,.*},
  dbus receive bus=session path=/org/flatpak/Authenticator/Oci{,/**}
       interface=org.flatpak.Authenticator.Oci{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/flatpak/Authenticator/Oci{,/**}
       interface=org.flatpak.Authenticator.Oci{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/flatpak/Authenticator/Oci{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/flatpak/Authenticator/Oci{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/flatpak/Authenticator/Oci{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.flatpak.Authenticator.Oci{,.*}}"),
  dbus send bus=session path=/org/flatpak/Authenticator/Oci{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  include if exists <local/flatpak-oci-authenticator>
}

# vim:syntax=apparmor
