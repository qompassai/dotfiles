abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,evolution-data-server/}evolution-user-prompter
profile evolution-user-prompter /{,usr/}lib{,exec,32,64}/{,evolution-data-server/}evolution-user-prompter flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/dconf-write>
  include <abstractions/gnome-strict>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.gnome.evolution.dataserver.UserPrompter0{,.*},
  dbus receive bus=session path=/org/gnome/evolution/dataserver/UserPrompter0{,/**}
       interface=org.gnome.evolution.dataserver.UserPrompter0{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gnome/evolution/dataserver/UserPrompter0{,/**}
       interface=org.gnome.evolution.dataserver.UserPrompter0{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/gnome/evolution/dataserver/UserPrompter0{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gnome/evolution/dataserver/UserPrompter0{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/gnome/evolution/dataserver/UserPrompter0{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.evolution.dataserver.UserPrompter0{,.*}}"),
  dbus send bus=session path=/org/gnome/evolution/dataserver/UserPrompter0{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  include if exists <local/evolution-user-prompter>
}

# vim:syntax=apparmor
