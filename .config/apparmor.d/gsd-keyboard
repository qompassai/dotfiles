abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/gsd-keyboard
profile gsd-keyboard /{,usr/}lib{,exec,32,64}/gsd-keyboard  flags=(attach_disconnected,complain) {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/bus-accessibility>
  include <abstractions/bus-session>
  include <abstractions/bus-system>
  include <abstractions/bus/org.a11y>
  include <abstractions/bus/org.freedesktop.locale1>
  include <abstractions/bus/org.gnome.SessionManager>
  include <abstractions/bus/org.gtk.vfs.MountTracker>
  include <abstractions/dconf-write>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/gnome-strict>
  include <abstractions/nameservice-strict>

  network inet stream,

  signal (receive) set=(term, hup) peer=gdm*,

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.gnome.SettingsDaemon.Keyboard{,.*},
  dbus receive bus=session path=/org/gnome/SettingsDaemon/Keyboard{,/**}
       interface=org.gnome.SettingsDaemon.Keyboard{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gnome/SettingsDaemon/Keyboard{,/**}
       interface=org.gnome.SettingsDaemon.Keyboard{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/gnome/SettingsDaemon/Keyboard{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gnome/SettingsDaemon/Keyboard{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/gnome/SettingsDaemon/Keyboard{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.SettingsDaemon.Keyboard{,.*}}"),
  dbus send bus=session path=/org/gnome/SettingsDaemon/Keyboard{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  /usr/share/dconf/profile/gdm r,
  /usr/share/gdm/greeter-dconf-defaults r,

  owner @{GDM_HOME}/greeter-dconf-defaults r,
  owner @{gdm_config_dirs}/.gsd-keyboard.settings-ported* rw,
  owner @{gdm_config_dirs}/dconf/user r,

  owner @{user_config_dirs}/.gsd-keyboard.settings-ported* rw,
  owner @{user_share_dirs}/gnome-settings-daemon/{,input-sources*} rw,

  include if exists <local/gsd-keyboard>
}

# vim:syntax=apparmor
