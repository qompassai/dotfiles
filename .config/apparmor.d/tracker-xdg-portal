abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/tracker-xdg-portal-3
profile tracker-xdg-portal /{,usr/}lib{,exec,32,64}/tracker-xdg-portal-3 flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/gnome-strict>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.freedesktop.portal.Tracker{,.*},
  dbus receive bus=session path=/org/freedesktop/portal/Tracker{,/**}
       interface=org.freedesktop.portal.Tracker{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/freedesktop/portal/Tracker{,/**}
       interface=org.freedesktop.portal.Tracker{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/freedesktop/portal/Tracker{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/freedesktop/portal/Tracker{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/freedesktop/portal/Tracker{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.portal.Tracker{,.*}}"),
  dbus send bus=session path=/org/freedesktop/portal/Tracker{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  include if exists <local/tracker-xdg-portal>
}

# vim:syntax=apparmor
