abi <abi/4.0>,

include <tunables/global>

@{lib_dirs} = /opt/google/chrome{,-stable,-beta,-unstable}

@{exec_path} = @{lib_dirs}/chrome-sandbox
profile chrome-sandbox /opt/google/chrome{,-stable,-beta,-unstable}/chrome-sandbox flags=(complain) {
  include <abstractions/base>

  capability setgid,
  capability setuid,
  capability sys_admin,
  capability sys_chroot,
  capability sys_resource,

  @{exec_path} mr,

  @{lib_dirs}/chrome      rpx,
  @{lib_dirs}/nacl_helper rix,

        @{PROC} r,
        @{PROC}/@{pids}/ r,
  owner @{PROC}/@{pid}/fd/ r,
  owner @{PROC}/@{pid}/oom_{,score_}adj rw,

  include if exists <local/chrome-sandbox>
}

# vim:syntax=apparmor
