abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/gnome-user-share-webdav
profile gnome-user-share-webdav /{,usr/}lib{,exec,32,64}/gnome-user-share-webdav flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.gnome.user-share.webdav{,.*},
  dbus receive bus=session path=/org/gnome/user-share/webdav{,/**}
       interface=org.gnome.user-share.webdav{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gnome/user-share/webdav{,/**}
       interface=org.gnome.user-share.webdav{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/gnome/user-share/webdav{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gnome/user-share/webdav{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/gnome/user-share/webdav{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.user-share.webdav{,.*}}"),
  dbus send bus=session path=/org/gnome/user-share/webdav{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  include if exists <local/gnome-user-share-webdav>
}

# vim:syntax=apparmor
