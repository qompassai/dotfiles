abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-generators/systemd-veritysetup-generator
profile systemd-generator-veritysetup /{,usr/}lib{,exec,32,64}/systemd/system-generators/systemd-veritysetup-generator  flags=(attach_disconnected,complain) {
  include <abstractions/base>
  include <abstractions/common/systemd>

  ptrace (read) peer=@{p_systemd},

  @{exec_path} mr,

  @{PROC}/@{pid}/cgroup r,

  include if exists <local/systemd-generator-veritysetup>
}

# vim:syntax=apparmor
