  dbus receive bus=session path=/org/gnome/OnlineAccounts{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.gnome.OnlineAccounts{,.*}}", label=goa-daemon),
  dbus (send receive) bus=session path=/org/gnome/SettingsDaemon/Color{,/**}
       interface=org.gnome.SettingsDaemon.Color{,.*}
       peer=(name="{@{busname},org.gnome.SettingsDaemon.Color{,.*}}", label=gsd-color),
  dbus (send receive) bus=session path=/org/gnome/SettingsDaemon/Color{,/**}
