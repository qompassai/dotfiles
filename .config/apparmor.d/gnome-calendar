       peer=(name="{@{busname},org.gnome.evolution.dataserver.Source{,.*}}", label=evolution-source-registry),
  dbus (send receive) bus=session path=/org/gnome/evolution/dataserver/Source{,/**}
       interface=org.freedesktop.DBus.Properties
