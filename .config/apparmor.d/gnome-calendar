  include <abstractions/bus-system>
  include <abstractions/bus/org.freedesktop.login1>
  include <abstractions/bus/org.freedesktop.NetworkManager>
  include <abstractions/bus/org.freedesktop.portal.Desktop>
  include <abstractions/bus/org.freedesktop.timedate1>
  include <abstractions/bus/org.gtk.vfs.MountTracker>
  include <abstractions/common/gnome>
  include <abstractions/nameservice-strict>
  include <abstractions/p11-kit>
  include <abstractions/ssl_certs>

  network netlink raw,

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.gnome.Calendar{,.*},
  dbus receive bus=session path=/org/gnome/Calendar{,/**}
       interface=org.gnome.Calendar{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gnome/Calendar{,/**}
       interface=org.gnome.Calendar{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/gnome/Calendar{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/gnome/Calendar{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/gnome/Calendar{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.Calendar{,.*}}"),
  dbus send bus=session path=/org/gnome/Calendar{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  #aa-dbus own bus=session name=org.gnome.Calendar.SearchProvider interface+=org.gnome.Shell.SearchProvider2

  dbus (send receive) bus=session path=/org/gnome/evolution/dataserver/AddressBook@{int}{,/**}
       interface=org.gnome.evolution.dataserver.AddressBook@{int}{,.*}
       peer=(name="{@{busname},org.gnome.evolution.dataserver.AddressBook@{int}{,.*}}", label=evolution-addressbook-factory),
