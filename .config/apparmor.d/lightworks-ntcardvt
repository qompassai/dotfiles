abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/lightworks/ntcardvt
profile lightworks-ntcardvt /{,usr/}lib{,exec,32,64}/lightworks/ntcardvt flags=(complain) {
  include <abstractions/base>

  @{exec_path} mr,

  include if exists <local/lightworks-ntcardvt>
}

# vim:syntax=apparmor
