abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/cups/backend/cups-brf
profile cups-backend-brf /{,usr/}lib{,exec,32,64}/cups/backend/cups-brf flags=(complain) {
  include <abstractions/base>

  capability setuid,

  @{exec_path} mr,

  /etc/papersize r,
  /etc/paperspecs r,

  include if exists <local/cups-backend-brf>
}

# vim:syntax=apparmor
