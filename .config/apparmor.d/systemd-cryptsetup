abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/systemd-cryptsetup @{lib}/systemd/systemd-cryptsetup
profile systemd-cryptsetup /{{,usr/}bin/systemd-cryptsetup,{,usr/}lib{,exec,32,64}/systemd/systemd-cryptsetup}  flags=(attach_disconnected,complain) {
  include <abstractions/base>
  include <abstractions/common/systemd>
  include <abstractions/disks-write>

  capability dac_read_search,
  capability ipc_lock,
  capability net_admin,
  capability sys_admin,

  @{exec_path} mr,

  /etc/fstab r,



  @{run}/ r,
  @{run}/cryptsetup/ r,
  @{run}/cryptsetup/* rwk,
  @{run}/systemd/ask-password/* rw,

  @{sys}/devices/virtual/bdi/*/read_ahead_kb r,
  @{sys}/fs/ r,

  @{run}/systemd/ask-password/ r,

        @{PROC}/devices r,
  owner @{PROC}/@{pid}/mountinfo r,



  include if exists <local/systemd-cryptsetup>
}

# vim:syntax=apparmor
