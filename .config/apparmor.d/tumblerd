abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,@{multiarch}/}tumbler-1/tumblerd
profile tumblerd /{,usr/}lib{,exec,32,64}/{,*-linux-gnu*/}tumbler-1/tumblerd flags=(complain) {
  include <abstractions/base>
  include <abstractions/bus-session>
  include <abstractions/desktop>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/gstreamer>
  include <abstractions/nameservice-strict>
  include <abstractions/thumbnails-cache-write>

  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.freedesktop.thumbnails.Cache1{,.*},
  dbus receive bus=session path=/org/freedesktop/thumbnails/Cache1{,/**}
       interface=org.freedesktop.thumbnails.Cache1{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/freedesktop/thumbnails/Cache1{,/**}
       interface=org.freedesktop.thumbnails.Cache1{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/freedesktop/thumbnails/Cache1{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/freedesktop/thumbnails/Cache1{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/freedesktop/thumbnails/Cache1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.thumbnails.Cache1{,.*}}"),
  dbus send bus=session path=/org/freedesktop/thumbnails/Cache1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.freedesktop.thumbnails.Manager1{,.*},
  dbus receive bus=session path=/org/freedesktop/thumbnails/Manager1{,/**}
       interface=org.freedesktop.thumbnails.Manager1{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/freedesktop/thumbnails/Manager1{,/**}
       interface=org.freedesktop.thumbnails.Manager1{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/freedesktop/thumbnails/Manager1{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/freedesktop/thumbnails/Manager1{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/freedesktop/thumbnails/Manager1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.thumbnails.Manager1{,.*}}"),
  dbus send bus=session path=/org/freedesktop/thumbnails/Manager1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  include <abstractions/bus/own-session>

  dbus bind bus=session name=org.freedesktop.thumbnails.Thumbnailer1{,.*},
  dbus receive bus=session path=/org/freedesktop/thumbnails/Thumbnailer1{,/**}
       interface=org.freedesktop.thumbnails.Thumbnailer1{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/freedesktop/thumbnails/Thumbnailer1{,/**}
       interface=org.freedesktop.thumbnails.Thumbnailer1{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/freedesktop/thumbnails/Thumbnailer1{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=session path=/org/freedesktop/thumbnails/Thumbnailer1{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=session path=/org/freedesktop/thumbnails/Thumbnailer1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.thumbnails.Thumbnailer1{,.*}}"),
  dbus send bus=session path=/org/freedesktop/thumbnails/Thumbnailer1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  @{exec_path} mr,

  @{bin}/gdk-pixbuf-thumbnailer rpx,

  /usr/share/backgrounds/xfce/{,**} r,
  /usr/share/thumbnailers/{,**} r,

  /etc/fstab r,
  /etc/xdg/tumbler/* r,

  owner /tmp/tumbler-@{rand6}.png r,
  owner /tmp/tumbler-@{rand6}.??? w,

  owner @{PROC}/@{pid}/mountinfo r,

  /dev/ r,

  include if exists <local/tumblerd>
}

# vim:syntax=apparmor
