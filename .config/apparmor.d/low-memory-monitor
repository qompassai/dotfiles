abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/low-memory-monitor
profile low-memory-monitor /{,usr/}lib{,exec,32,64}/low-memory-monitor  flags=(attach_disconnected,complain) {
  include <abstractions/base>

  capability ipc_lock,

  @{exec_path} mr,

  owner @{PROC}/pressure/memory rw,

  include if exists <local/low-memory-monitor>
}

# vim:syntax=apparmor
