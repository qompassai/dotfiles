abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,at-spi2{,-core}/}at-spi2-registryd
profile at-spi2-registryd /{,usr/}lib{,exec,32,64}/{,at-spi2{,-core}/}at-spi2-registryd  flags=(attach_disconnected,complain) {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/bus-accessibility>
  include <abstractions/bus-session>
  include <abstractions/bus/org.gnome.SessionManager>
  include <abstractions/X-strict>

  signal receive set=term peer=gdm,
  signal receive set=hup  peer=gdm-session-worker,

  include <abstractions/bus/own-accessibility>

  dbus bind bus=accessibility name=org.a11y.atspi{,.*},
  dbus receive bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.a11y.atspi{,.*}
       peer=(name="@{busname}"),
  dbus send bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.a11y.atspi{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus receive bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  dbus receive bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.a11y.atspi{,.*}}"),
  dbus send bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  dbus (send receive) bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.a11y.{B,b}us{,.*}
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*}}", label="@{p_dbus_accessibility}"),
  dbus (send receive) bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*}}", label="@{p_dbus_accessibility}"),
  dbus send bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*}}", label="@{p_dbus_accessibility}"),
  dbus send bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*}}", label="@{p_dbus_accessibility}"),
  dbus receive bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*}}", label="@{p_dbus_accessibility}"),

  dbus receive bus=session
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name=:*, label=gnome-shell),

  @{exec_path} mr,

  include if exists <local/at-spi2-registryd>
}

# vim:syntax=apparmor
