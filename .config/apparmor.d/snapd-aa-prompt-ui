abi <abi/4.0>,

include <tunables/global>

@{lib_dirs} = @{lib}/ /snap/{snapd,core}/@{int}@{lib}

@{exec_path} = @{lib_dirs}/snapd/snapd-aa-prompt-ui
profile snapd-aa-prompt-ui /{{,usr/}lib{,exec,32,64}/snapd/snapd-aa-prompt-ui,snap/{snapd,core}/[0-9]{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}/{,usr/}lib{,exec,32,64}/snapd/snapd-aa-prompt-ui} flags=(complain) {
  include <abstractions/base>

  @{exec_path} mrix,
  @{lib_dirs}/**.so* mr,

  @{lib_dirs}/snapd/info r,

  @{PROC}/cmdline r,

  include if exists <local/snapd-aa-prompt-ui>
}

# vim:syntax=apparmor
