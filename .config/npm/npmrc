# References: https://docs.npmjs.com/cli/v11/configuring-npm/npmrc
always-auth=true 
audit=true
cache=${XDG_CACHE_HOME:-$HOME/.cache}/npm
engine-strict=true
fetch-retries=5
fetch-timeout=30000
fund=true
init-module=${XDG_CONFIG_HOME:-$HOME/.config}/npm/init.js
legacy-peer-deps=false
loglevel=info
package-lock=true
prefix=${XDG_DATA_HOME:-$HOME/.local}/npm
progress=true
registry=https://registry.npmjs.org/
save-exact=true
strict-ssl=true
unsafe-perm=false
update-notifier=true
userconfig=${XDG_CONFIG_HOME:-$HOME/.config}/npm/npmrc
version-tag-prefix=v
