# /qompassai/dotfiles/.config/swtpm/swtpm-localca.options
# Qompass AI Software Trusted Platform Module (SWTPM) Local Cert Options Config
# Copyright (C) 2025 Qompass AI, All rights reserved
###############################################################################
# References: https://github.com/stefanberger/swtpm
--cert-validity 3650
--decryption
--ek-use
--encryption
--host localhost
--issuer Fedora-CA
--keyusage sign
--locality 2
--model QEMU
--no-check-ek-cert
--not-after 20370101
--not-before 20240101
--override-kid
--platform-manufacturer Fedora
--platform-model QEMU
--platform-version 2.1
--public-exponent 65537
--serial 01
--signer FedoraCA
--signkey ${XDG_DATA_HOME}/swtpm-localca/signkey.pem
--verbose
