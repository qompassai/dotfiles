# Reference: https://ghostty.org/docs/config
# ghostty +show-config --docs
alpha-blending = native
async-backend = auto
auto-update = check
background = #000000
background-blur = 0
background-opacity = 0.25
clipboard-paste-bracketed-safe = true
clipboard-paste-protection = true
clipboard-read = allow
clipboard-trim-trailing-spaces = true
clipboard-write = allow
command = /usr/bin/fish --login --interactive
config-file = font.conf
config-file = gtk.conf
config-file = keybinds.conf
config-file = linux.conf
config-file = mouse.conf
copy-on-select = true
grapheme-width-method = unicode
image-storage-limit = 4294967295
quick-terminal-animation-duration = 0.2
quick-terminal-keyboard-interactivity = on-demand
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-autohide = true
quit-after-last-window-closed = true
resize-overlay-duration = 4s 200ms
scrollback-limit = 100000000
shell-integration = detect
shell-integration-features = cursor,ssh-env,ssh-terminfo,sudo,title
split-divider-color = #7DF9FF
title-report = false
unfocused-split-fill = #7DF9FF
window-decoration = true
window-padding-balance = true
window-padding-x = 2
window-padding-y = 2
