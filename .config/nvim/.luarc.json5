{
  "workspace": {
    "library": [
      "${3rd}",
      "~/.config/nvim/lua/types",
      "~/.config/nvim/lua/types/lang"
    ],
    "checkThirdParty": false
  },
  "Lua.diagnostics.globals": [
    "vim", "jit",
    "use_blink_cmp", "lazydev_enabled",
    "LuaLangModule", "LuaLangGlobals", "PureMarker", "LuaUtils"
  ]
}

