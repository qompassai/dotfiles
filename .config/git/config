####################################################
# Reference: https://git-scm.com/docs/git-config
[advice]
    addEmptyPathspec        = false
    addIgnoredFile          = true
    detachedHead            = false
    pushAlreadyExists       = false
    pushFetchFirst          = true
    pushNeedsForce          = true
    pushNonFFCurrent        = false
    pushNonFFMatching       = false
    pushRefNeedsUpdate      = false
    pushUpdateRejected      = true
    nestedTag = false
    statusAheadBehind = false
    statusHints = true
    statusUoption = false
    submodulesNotUpdated = true
    waitingForEditor = false
[alias]
    br                            = branch
    ci                            = commit
    co                            = checkout
    di                            = diff
    lg                            = log --graph --abbrev-commit --decorate --date=relative --all
    rebasei                       = rebase -i
    st                            = status
    gcf                           = commit --fixup
[blame]
    coloring                      = highlightRecent
    date                          = iso
    ignoreRevsFile                = .git-blame-ignore-revs
    markUnblamableLines           = true
    markIgnoredLines        = true
    showEmail               = true
    showRoot                = true
[branch]
    autoSetupMerge          = always
    autoSetupRebase         = remote
    sort                    = -committerdate
    sortBy                  = committerdate
[checkout]
    defaultRemote           = origin
    guess                   = true
    workers                 = 0
    thresholdForParallelism = 200
[clean]
    requireForce            = true
[clone]
    defaultRemoteName       = origin
    rejectShallow           = false
[color]
    advice                        = auto
    branch                        = auto
    diff                          = auto
    status                        = auto
    ui                            = auto
[column]
    ui                            = auto,column,dense
    branch                        = auto
    clean                         = auto
    status                        = auto
    tag                           = auto
[commit]
    cleanup                       = strip
    gpgsign                       = true
    status                        = true
    #template               = ~/.config/git/commit-template.txt
    verbose                       = false
[commitGraph]
    changedPaths                  = true
    changedPathsVersion           = 2
    generationVersion             = 2
    maxNewFilters                 = 64
[core]
    abbrev                        = auto
    askPass                       = /usr/bin/pass-sshaskpass
    autocrlf                      = input
    bigFileThreshold              = 50m
    checkStat                     = default
    commitgraph                   = true
    compression                   = 9
    deltaBaseCacheLimit           = 256m
    editor                        = nvim
    eol                           = native
    #excludesfile                 = ~/.gitignore
    filemode                      = false
    filesRefLockTimeout           = 100
    fscache                       = true
    fsmonitor                     = false
    fsmonitorHookVersion          = 2
    ignoreCase                    = false
    ignoreStat                    = false
    maxTreeDepth                  = 2048
    multiPackIndex                = true
    packedRefsTimeout             = 1000
    packedGitLimit                = 512m
    packedGitWindowSize           = 1g
    protectHFS                    = true
    protectNTFS                   = true
    pager                         = nvimpager
    preloadindex                  = true
    quotePath                     = false
    safecrlf                      = false
    sparseCheckoutCone            = true
    splitIndex                    = true
    symlinks                      = true
    trustctime                    = true
    untrackedCache                = true
    whitespace                    = blank-at-eol,space-before-tab,blank-at-eof,-cr-at-eol,tabwidth=4
[credential]
    helper                        = /usr/lib/git-core/git-credential-libsecret
    interactive                   = true
    protectProtocol               = true
    sanitizePrompt                = true
[diff]
    algorithm                     = histogram
    autoRefreshIndex              = true
    colorMoved                    = default
    colorMovedWS                  = ignore-space-change
    context                       = 3
    dirstat                       = changes,noncumulative,3
    dstPrefix                     = b/
#   external             =
    ignoreSubmodules              = untracked
    indentHeuristic               = true
    interHunkContext              = 0
    mnemonicPrefix                = true
    noPrefix                      = false
#    orderFile                    =
    relative                      = false
    renameLimit                   = 1000
    renames                       = true
    srcPrefix                     = a/
    statGraphWidth                = 50
    statNameWidth                 = 50
    submodule                     = short
    suppressBlankEmpty            = false
#    tool                         =
#    guitool                      =
    trustExitCode                 = false
    wsErrorHighlight              = new
#    wordRegex                    =
[feature]
    experimental                  = true
    manyFiles                     = true
[fetch]
    fsckobjects                   = false
    negotiationAlgorithm          = consecutive
    output                        = full
    parallel                      = 12
    prune                         = false
    pruneTags                     = false
    recurseSubmodules             = on-demand
    showForcedUpdates             = true
    writeCommitGraph              = true
[gc]
    aggressiveDepth               = 50
    aggressiveWindow              = 250
    auto                          = 8000
    autoPackLimit                 = 50
    autoDetach                    = true
    bigPackThreshold              = 0
    writeCommitGraph              = true
    logExpiry                     = 1.day
    packRefs                      = true
    cruftPacks                    = true
    maxCruftSize                  = 0
    pruneExpire                   = 2.weeks.ago
    worktreePruneExpire           = 3.months.ago
    reflogExpire                  = 90.days.ago
    reflogExpireUnreachable       = 30.days.ago
    #recentObjectsHook            =
    #repackFilter                 =
    #repackFilterTo               =
    rerereResolved                = 60
    rerereUnresolved              = 15
[gpg]
    format                        = openpgp
    minTrustLevel                 = fully
    program                       = gpg

[grep]
    column                        = true
    extendedRegexp                = true
    fallbackToNoIndex             = true
    fullName                      = true
    lineNumber                    = true
    patternType                   = extended
    threads                       = 0
[help]
    autocorrect                   = 1
    browser                       = firefox
    format                        = web
    htmlPath                      = https://git-scm.com/docs
[http]
    cookieFile                    = ~/.cache/git/http-cookies.txt
    emptyAuth                     = false
    followRedirects               = initial
    keepAliveCount                = 9
    keepAliveIdle                 = 120
    keepAliveInterval             = 60
    lowSpeedLimit                 = 1
    lowSpeedTime                  = 600
    maxRequests                   = 10
    minSessions                   = 1
    #pinnedPubkey                 =
    postBuffer                    = 1048576
    proactiveAuth                 = auto
    #proxy                        =
    proxyAuthMethod               = digest
    proxySSLCAInfo                = /etc/ssl/certs/ca-certificates.crt
    #proxySSLCert                 =
    proxySSLCertPasswordProtected = true
    #proxySSLKey                  =
    saveCookies                   = true
    schannelCheckRevoke           = true
    schannelUseSSLCAInfo          = false
    #sslBackend                   =
    sslCAInfo                     = /etc/ssl/certs/ca-certificates.crt
    sslCAPath                     = /etc/ssl/certs
    #sslCert                      =
    sslCertPasswordProtected      = true
    sslCertType                   = PEM
    #sslCipherList                =
    #sslKey                       =
    sslKeyType                    = PEM
    sslTry                        = false
    sslVerify                     = true
    sslVersion                    = tlsv1.3
    userAgent                     = git
    version                       = HTTP/1.1
[i18n]
    commitEncoding                = utf-8
    logOutputEncoding             = utf-8

[index]
    recordEndOfIndexEntries       = true
    recordOffsetTable             = true
    skipHash                      = false
    sparse                        = false
    threads                       = true
    version                       = 4
[init]
    defaultBranch                 = main
    defaultObjectFormat           = sha1
    defaultRefFormat              = files
    #templateDir                  = ~/.config/git/templates
[instaweb]
    browser                       = firefox
    #httpd                        = apache2 -f /etc/apache2/git-instaweb.conf
    local                         = true
    #modulePath                   = /usr/lib/apache2/modules
    #port                         = 1234
[log]
    abbrevCommit                  = true
    date                          = iso
    decorate                      = auto
    diffMerges                    = separate
    #excludeDecoration            =
    follow                        = false
    graphColors                   = red,green,yellow,blue,magenta,cyan
    #initialDecorationSet         =
    mailmap                       = true
    showRoot                      = true
    showSignature                 = false
[pack]
    allowPackReuse                = multi
    compression                   = -1
    deltaCacheLimit               = 1000
    deltaCacheSize                = 256m
    indexVersion                  = 2
    #island                       =
    #islandCore                   =
    #packSizeLimit                =
    #preferBitmapTips             =
    readReverseIndex              = true
    threads                       = 0
    useBitmaps                    = true
    useBitmapBoundaryTraversal    = true
    usePathWalk                   = false
    useSparse                     = true
    window                        = 10
    windowMemory                  = 0
    writeBitmapHashCache          = true
    writeBitmapLookupTable        = false
    writeReverseIndex             = true
[push]
    autoSetupRemote               = true
    default                       = simple
    followTags                    = true
    gpgSign                       = if-asked
    negotiate                     = true
    recurseSubmodules             = on-demand
    useBitmaps                    = true
    useForceIfIncludes            = true
[pull]
    autostash                     = true
    ff                            = only
    rebase                        = true
[rebase]
    abbreviateCommands            = false
    advertiseAtomic               = true
    autogc                        = false
    autoSquash                    = false
    autoStash                     = false
    backend                       = merge
    denyCurrentBranch             = refuse
    denyDeletes                   = true
    denyDeleteCurrent             = true
    denyNonFastForwards           = true
    forkPoint                     = true
    missingCommitsCheck           = warn
    rescheduleFailedExec          = true
    rebaseMerges                  = no-rebase-cousins
    stat                          = true
    updateRefs                    = true
[receive]
    fsckobjects                   = false
[repack]
    #cruftDepth                   =
    #cruftThreads                 =
    #cruftWindow                  =
    #cruftWindowMemory            = 
    midxMustContainCruft          = true
    packKeptObjects               = false
    updateServerInfo              = true
    useDeltaBaseOffset            = true
    useDeltaIslands               = false
    writeBitmaps                  = true
[rerere]
    autoupdate                    = true
    enabled                       = true
[status]
    submoduleSummary              = true
[submodule]
    recurse                       = true
[tag]
    sort                          = version:refname
[transfer]
    bundleURI                     = true
    fsckobjects                   = false
[user]
	signingkey                    = 0xBA8D40BF292A6CD9
