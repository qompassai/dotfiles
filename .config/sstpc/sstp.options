#################################################
remotename      "$(pass show sstp/remotename)"
linkname        "$(pass show sstp/linkname)"
ipparam         "$(pass show sstp/ipparam)"
name            "$(pass show sstp/name)"
password        "$(pass show sstp/pass)"
plugin          sstp-pppd-plugin.so
sstp-sock       /run/sstpc/sstpc-uds-sock
noauth
usepeerdns
