{
    "server": "$pass show ssr/addr",
    "server_port": "$(pass show ssr/server_port3)",
    "local_port": "$(pass show ssr/local_port4)",
    "local_address": "$(pass show ssr/local_addr4)",
    "password": "$(pass show ssr/pass)",
    "timeout": "$(pass show ssr/timeout)",
    "method": "$(pass show ssr/method3)"
}
