# /qompassai/dofiles/.config/mkinitcpio-systemd-tool/network/initrd-network.network
# Qompass AI Mkinitcpio Systemd Tool Initrd-Network Config
# Copyright (C) 2025 Qompass AI, All rights reserved
####################################################
[Match]
Name=eth*
#Name=en*
[Network]
DHCP=both
DNS=1.1.1.1
DNS=2606:4700:4700::1111
Gateway=192.168.1.1
IPForward=true
IPv6AcceptRA=true
KeepConfiguration=yes
[DHCP]
RouteMetric=100
SendHostname=true
UseDNS=true
UseHostname=true
