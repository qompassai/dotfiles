#################################################
login
lcp-echo-interval 10
lcp-echo-failure 2
noipx
refuse-pap
refuse-chap
refuse-mschap
require-mppe
require-mschap-v2
nodefaultroute
proxyarp
bsdcomp
deflate
accomp
noccp
nopcomp
nopredictor1
novj
novjccomp
debug 7
