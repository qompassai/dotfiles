[calendars]
[[qompass]]
path = ~/.local/share/calendars/qompass/
type = calendar
readonly = false

[[foamedmapgm]]
path = ~/.local/share/calendars/gmail/
type = calendar
readonly = false

[[map26gm]]
path = ~/.local/share/calendars/gmail/
type = calendar
readonly = false

[default]
default_calendar = qompass

[view]
frame = color
theme = dark
agenda_event_format = {calendar-color}{start-end-time-style} {title} ({location})

[sqlite]
path = ~/.local/share/khal/khal.db
