syntax "RST" "\.rest$" "\.rst$"
color red "\*\*[^*]+\*\*"
color brightred "::"
color blue "`[^`]+`_{1,2}"
color yellow "``[^`]+``"
color cyan "^\.\. .*$"
color cyan "^__ .*$"
color yellow "^###+$"
color yellow "^\*\*\*+$"
color magenta "^===+$"
color red "^---+$"
color green "^\^\^\^+$"
color blue "^"""+$"
