syntax json "\.json$"
comment ""
color green ":[[:blank:]]*\-?(0|[1-9][0-9]*)(\.[0-9]+)?([Ee]?[-+]?[0-9]+)?"
color brightmagenta "".+""
color green ":[[:blank:]]*"#[[:xdigit:]]+""
color green "\\(["\/bfnrt]|u[[:xdigit:]]{4})"
color green "\<(true|false|null)\>"
color brightblue ""[^"]+"[[:blank:]]*:"
color brightblue "[][]"
color brightred "[{},:]"
color cyan "(^|[[:blank:]]+)(//|#).*"
color ,green "[[:space:]]+$"
