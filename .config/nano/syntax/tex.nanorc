syntax tex "\.tex$"
magic "(La)?TeX document"
comment "%"
linter chktex -v0 -q -I
color green "\\.|\\[[:alpha:]]*"
color magenta "[{}]"
color blue "(^|[^\])%.*"
color brightblue "^[[:space:]]*%.*$"
color brightblue "[^[:alnum:]_]%.*$"
color brightcyan "\\[A-Za-z@]+"
color brightmagenta "\\begin\{[A-Za-z*]+\}"
color brightmagenta "\\end\{[A-Za-z*]+\}"
color brightgreen "\\\[(.|\n)*?\\\]"
color brightgreen "\\\((.|\n)*?\\\)"
color brightgreen "\$[^$]+\$"
color brightyellow "\[[^]]+\]"
color brightyellow "\{[^}]+\}"
color brightwhite "[&_#\^\~]"
color brightcyan "\\(part|chapter|section|subsection|subsubsection|paragraph|subparagraph)\b"
