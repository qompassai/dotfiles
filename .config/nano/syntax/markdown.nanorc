syntax markdown "\.md$"
comment "<!--|-->"
color magenta "^[ 	]*>.*"
color brightmagenta "^(    |	)* ? ? ?(\*|\+|-|[0-9]+\.)( +|	)"
color green "\*[^* 	][^*]*\*|_[^_ 	][^_]*_"
color brightgreen "\*\*[^*]+\*\*|__[^_]+__"
color red "~~[^~]+~~"
color ,blue "  $"
color brightblue "\[[^]]+\]\([^)]+\)"
color brightmagenta "!?\[[^]]+\]"
color brightcyan "`[^`]+`"
color brightcyan "^(    |	)+ *([^*+0-9> 	-]|[*+-]\S|[0-9][^.]).*"
color brightcyan start="```" end="```$"
color brightyellow "^#.*"
color brightyellow "^(=+|-+)$"
color cyan "<[^>]+>"
color cyan start="<!--" end="-->"
