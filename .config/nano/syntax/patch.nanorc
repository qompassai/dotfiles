syntax patch "\.(patch|diff|debdiff|rej)$"
magic "diff output"
comment ""
color brightgreen "^\+.*"
color ,green "[[:space:]]+$"
color brightblue "^ .*"
color brightred "^-.*"
color magenta "^(Index:|diff)[[:blank:]].*"
color red "^---.*"
color green "^\+\+\+.*"
color brightyellow "^@@.*"
color cyan start="^---$" end="^$"
