syntax autoconf "\.(ac|m4)$"
comment "#"
color yellow "\<(if|test|then|elif|else|fi|case|esac|ifelse|for|in|do|done)\>"
color yellow "=|!=|&&|\|\|"
color cyan "\<[[:upper:][:digit:]_]+\>"
color red "\<[-_.0-9]+\>"
color red ""[^"]*"|'[^']*'"
color green "`[^`]*`"
color brightred "^[[:blank:]]*\*\*\*.*"
color magenta "\[|\]|\(|\)"
color blue "^[[:blank:]]*#.*|\<dnl.*"
color ,green "[[:space:]]+$"
