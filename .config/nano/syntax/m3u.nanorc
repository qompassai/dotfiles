syntax "m3u" "\.(m3u|m3u8)$"
color brightcyan "^#EXTINF.*,[^,]*$"
color brightyellow "^#[^:]*:[^ ,]*"
color brightyellow "=[^ ,]*"
color brightyellow "=[\"][^\"]*[\"]"
color brightgreen "[a-zA-Z-]*="
color brightred "^#EXT[-A-Z]*:"
color brightmagenta "^#EXTM3U"
color normal "[,=]"
color normal "^[^#].*"
