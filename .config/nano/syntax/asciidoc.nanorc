syntax "AsciiDoc" "\.(asc|asciidoc|adoc)$"
color brightred "^=[[:space:]].+$"
color red "^==[[:space:]].*$"
color red "^----+$"
color magenta "^===[[:space:]].*$"
color magenta "^~~~~+$"
color green "^====[[:space:]].*$"
color green "^\^\^\^\^+$"
color brightblue "^=====[[:space:]].*$"
color brightblue "^\+\+\+\++$"
color brightgreen ":.*:"
color brightred "\{[a-z0-9]*\}"
color red "\\\{[a-z0-9]*\}"
color red "\+\+\+\{[a-z0-9]*\}\+\+\+"
color yellow "^\..*$"
color magenta "^\[(source,.+|NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]"
color yellow ".*[[:space:]]\+$"
color yellow "_[^_]+_"
color yellow "\*[^\*]+\*"
color yellow "\+[^\+]+\+"
color yellow "`[^`]+`"
color yellow "\^[^\^]+\^"
color yellow "~[^~]+~"
color yellow "'[^']+'"
color cyan "`{1,2}[^']+'{1,2}"
color brightmagenta "^[[:space:]]*[\*\.-]{1,5}[[:space:]]"
color brightwhite "\[\[.*\]\]"
color brightwhite "<<.*>>"
