# /qompassai/dotfiles/.config/hostapd/hostapd.eap_user
# Qompass AI Hostapd EAP User Config
# Copyright (C) 2025 Qompass AI, All rights reserved
#####################################################
"user"		MD5	"pass show hostapd/eapp"
"test user"	MD5	"$(pass show hostapd/eapu)"
"example user"	TLS
"DOMAIN\user"	MSCHAPV2	"$(pass show hostapd/du)"
"gtc user"	GTC	"$(pass show hostapd/gtcu)"
"pax user"	PAX	"$(pass show hostapd/paxu)"
"pax.user@example.com"	PAX	
"psk user"	PSK	"unknown"
"psk.user@example.com"	PSK	
"sake.user@example.com"	SAKE
"ttls"		TTLS
"not anonymous"	PEAP
"0"*		AKA,TTLS,TLS,PEAP,SIM
"1"*		SIM,TTLS,TLS,PEAP,AKA
"2"*		AKA,TTLS,TLS,PEAP,SIM
"3"*		SIM,TTLS,TLS,PEAP,AKA
"4"*		AKA,TTLS,TLS,PEAP,SIM
"5"*		SIM,TTLS,TLS,PEAP,AKA
"6"*		AKA'
"7"*		AKA'
"8"*		AKA'

*		PEAP,TTLS,TLS,SIM,AKA

"t-md5"		MD5	"$(pass show tmd5/p)"	[2]
"DOMAIN\t-mschapv2"	MSCHAPV2	"$(pass show tmschap/p)"	[2]
"t-gtc"		GTC	"$(pass show tgtc/p)"	[2]
"not anonymous"	MSCHAPV2	"$(pass show na/p)"	[2]
"user"		MD5,GTC,MSCHAPV2	"$(pass show user/p)"	[2]
"test user"	MSCHAPV2	hash:	[2]
"ttls-user"	TTLS-PAP,TTLS-CHAP,TTLS-MSCHAP,TTLS-MSCHAPV2	"$(pass show ttls/p)"	[2]
"0"*		AKA	[2]
"1"*		SIM	[2]
"2"*		AKA	[2]
"3"*		SIM	[2]
"4"*		AKA	[2]
"5"*		SIM	[2]
"6"*		AKA'	[2]
"7"*		AKA'	[2]
"8"*		AKA'	[2]
