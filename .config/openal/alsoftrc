# References: https://github.com/kcat/openal-soft/blob/master/alsoftrc.sample
[alsa/default]
device = hw:0,0
capture = hw:1,0
[bformat]
format = ambix
sample-type = float32
[general]
disable-cpu-exts =
drivers = pulse,alsa,pipewire,jack
channels =
sample-type = float32
frequency =48000
period_size =
periods = 3
stereo-mode = auto
stereo-encoding = hrtf
ambi-format = ambix
hrtf-mode = full
hrtf-size = 0
default-hrtf =
/usr/share/openal/hrtf)
hrtf-paths =
cf_level = 0
resampler = spline
rt-prio = 1
rt-time-limit = true
sources = 256
slots = 64
sends = 6
front-stablizer = true
output-limiter =
dither =
dither-depth = 0
volume-adjust = 0
#excludefx =
#default-reverb = Arena
trap-alc-error = true
trap-al-error = true
[decoder]
hq-mode = true
distance-comp = true
nfc = true
speaker-dist = 1
#quad =
#surround51 =
#surround61 =
#surround71 =
#surround714 =
#surround3d71 =
[debug]
debug-out = stderr
debug-level = info
debug-sources = all
[uhj]
decode-filter = fire512
encode-filter = iir
[reverb]
boost = 0
[pipewire]
assume-audio = true
rt-mix = true
[pulse]
spawn-server = false
allow-moves = true
fix-rate = false
adjust-latency = false
[alsa]
device = default
device-prefix = plughw:
#device-prefix- =
#custom-devices =
capture = default
capture-prefix = plughw:
## capture-prefix-*: (global)
#  Card- and device-specific prefixes may be used to override the
#  capture-prefix option. The option may specify the card id (eg,
#  capture-prefix-NVidia), or the card id and device index (eg,
#  capture-prefix-NVidia-0). The card id is case-sensitive.
#capture-prefix- =
#custom-captures =
mmap = true
allow-resampler = true
[oss]
#device = /dev/dsp
#capture = /dev/dsp
[solaris]
#  Sets the device name for Solaris output.
#device = /dev/audio
[qsa]
[jack]
#spawn-server = false
#custom-devices =
rt-mix = true
connect-ports = true
buffer-size = 0
[wasapi]
spatial-api = true
exclusive-mode = true
allow-resampler = true
[dsound]
[winmm]
[port]
device = -1
capture = -1
[wave]
#file =
bformat = true
[eax]
enable = true
trace-commits = true
[game_compat]
default-error = 0xA004
nfc-scale = 1
enable-sub-data-ext = true
reverse-x = true
reverse-y = true
reverse-z = true
#vendor-override =
#version-override =
#renderer-override =
