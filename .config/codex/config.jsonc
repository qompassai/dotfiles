//qompassai/dotfiles/.config/codex/config.jsonc
//Qompass AI Codex Config
//Copyright (C) 2025 Qompass AI, All rights reserved
////////////////////////////////////////////////////
// Reference: https://developers.openai.com/codex/local-config/
{
  "approval_policy": "on-request",
  "chatgpt_base_url": "https://chat.openai.com",
  "experimental_instructions_file": "./AGENTS.md",
  "experimental_use_exec_command_tool": true,
  "experimental_use_rmcp_client": true,
  "file_opener": "nvim",
  "forced_chatgpt_workspace_id": "",
  "forced_login_method": "api",
  "hide_agent_reasoning": false,
  "history.max_bytes": 1048576,
  "history.persistence": "save-all",
  "instructions": "",
  "mcp_servers": {
    "default": {
      "args": [],
      "bearer_token_env_var": "$(pass show mcp/reapertoken)",
      "command": "",
      "cwd": "",
      "disabled_tools": [],
      "enabled": true,
      "enabled_tools": [],
      "env": {},
      "env_http_headers": {},
      "env_vars": [],
      "http_headers": {},
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 60,
      "url": ""
    }
  },
  "model": "gpt-5-codex",
  "model_context_window": 8192,
  "model_max_output_tokens": 1024,
  "model_provider": "openai",
  "model_providers": {
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "env_http_headers": {},
      "env_key": "$(pass show openai/api)",
      "http_headers": {},
      "name": "OpenAI",
      "query_params": {},
      "request_max_retries": 4,
      "stream_idle_timeout_ms": 300000,
      "stream_max_retries": 5,
      "wire_api": "chat"
    }
  },
  "model_reasoning_effort": "high",
  "model_reasoning_summary": "detailed",
  "model_reasoning_summary_format": "experimental",
  "model_supports_reasoning_summaries": true,
  "model_verbosity": "high",
  "notify": [],
  "otel.environment": "dev",
  "otel.exporter": "none",
  "otel.log_user_prompt": false,
  "profile": "default",
  "profiles": {},
  "project_doc_fallback_filenames": ["README.md", "INSTRUCTIONS.md"],
  "project_doc_max_bytes": 8192,
  "projects": {},
  "sandbox_mode": "workspace-write",
  "sandbox_workspace_write": {
    "exclude_slash_tmp": true,
    "exclude_tmpdir_env_var": true,
    "network_access": false,
    "writable_roots": ["./"]
  },
  "shell_environment_policy": {
    "exclude": [],
    "ignore_default_excludes": false,
    "include_only": [],
    "inherit": "core",
    "set": {}
  },
  "show_raw_agent_reasoning": true,
  "tools": {
    "view_image": true,
    "web_search": true
  },
  "tui": {},
  "tui.notifications": true
}
