// /qompassai/dotfiles/.config/ngspice/scripts/vlnggen
// Qompass AI NgSpice VLNG Gen Script
// Copyright (C) 2025 Qompass AI, All rights reserved
///////////////////////////////////////////////////////
set bad=0
if $?argc = 0
   set bad=1
end

if $argc <= 0
   set bad=1
end

if $bad
   echo Arguments acceptable to Verilator are required.
   quit
end


set noglob


if $oscompiled = 8
   setcs cflags="--CFLAGS -fpic --compiler msvc"
else
   setcs cflags="--CFLAGS -fpic"
end

if $oscompiled = 2 | $oscompiled = 3 | $oscompiled = 8
   set windows=1
   set dirsep1="\\"
   set dirsep2="/"
   set vloc="C:/mingw64/bin/verilator"
   set run_verilator="perl $vloc" 
else
   set windows=0
   set dirsep1="/"
   set run_verilator=verilator
end

if $oscompiled = 7 // MacOS
   set macos=1
   setcs cflags="$cflags --compiler clang"
else
   set macos=0
end

set silent_fileio
fopen fh inputs.h
if $fh >= 0
   echo File inputs.h (and any other header files) in current directory
   echo may interfere with compilation.
   quit
end
unset silent_fileio

let index=1
set off=1
set timing=1
repeat $argc
    set base="$argv[$&index]"
    let index = index + 1
    if $timing <> 0
        strcmp timing "$base" "--timing"
    end
    strstr l "$base" ""
    if $l > 2             
        strslice tail "$base" -2 2
	strcmp bad "$tail" ".v"
	if $bad <> 0
	    set base=""
	    continue
	end
	let l = $l - 2
	strslice base "$base" 0 $&l
    else
        set base=""
        continue
    end

    dowhile $off >= 0 
        strstr off "$base" "$dirsep1"
	if $windows
	   if $off < 0
	      strstr off "$base" "$dirsep2"
	   end
	end
        if $off >= 0
        let off=$off+1
            strslice base "$base" $&off $l
        end
    end

    strstr l "$base" ""
    if $l > 0
        break
    end
end

if index - 1 > $argc
    set base=verilated    
end


set tail="_obj_dir"
setcs objdir="$base$tail"


if $windows
   setcs tail=".DLL"
else
   setcs tail=".so"
end
setcs soname="$base$tail"

setcs prefix="Vlng"


shell $run_verilator --Mdir $objdir --prefix $prefix $cflags --cc $argv
if $shellstatus > 0
    quit
end

cd $objdir
echo "/* Generated code: do not edit. */" > inouts.h
echo "/* Generated code: do not edit. */" > inputs.h
echo "/* Generated code: do not edit. */" > outputs.h

set htail=".h"
setcs inout="VL_INOUT"
setcs in="VL_IN"
setcs out="VL_OUT"

set fn="$prefix$htail"
fopen fh $fn
if $fh < 0
   quit
end

while 1
    fread line $fh l
    if $l < 0
       break
    end

    strstr off "$line" ")"
    if $off < 0
       continue          
    end
    let off = $off + 1
    strslice line "$line" 0 $&off


    strstr off "$line" $inout
    if $off >= 0  
       let off = $off + 8
       strslice line "$line" $&off $l
       strstr off "$line" "("
       strslice size "$line" 0 $off
       let off = $off + 2
       strslice line "$line" $&off $l
       echo VL_DATA($size,$line >> inouts.h
       continue
    end


    strstr off "$line" $in
    if $off >= 0
       let off = $off + 5 
       strslice line "$line" $&off $l
       strstr off "$line" "("
       strslice size "$line" 0 $off
       let off = $off + 2 
       strslice line "$line" $&off $l
       echo VL_DATA($size,$line >> inputs.h
       continue
    end


    strstr off "$line" $out
    if $off >= 0 
       let off = $off + 6
       strslice line "$line" $&off $l
       strstr off "$line" "("
       strslice size "$line" 0 $off
       let off = $off + 2
       strslice line "$line" $&off $l
       echo VL_DATA($size,$line >> outputs.h
       continue
    end
end
fclose $fh
cd ..


set shimfile=verilator_shim.cpp
set shimobj=verilator_shim.o
set mainfile=verilator_main.cpp
set srcdir=src
set hfile="cmtypes.h"
set hpath="ngspice$dirsep1$hfile"
set silent_fileio

let i=1
repeat $#sourcepath
  set stem="$sourcepath[$&i]"
  let i = i + 1
  set fn="$stem$dirsep1$shimfile"
  fopen fh "$fn"
  if $fh < 0
    set stem="$stem$dirsep1$srcdir"
    set fn="$stem$dirsep1$shimfile"
    fopen fh $fn
  end
  if $fh > 0
    fclose $fh
    set hn="$stem$dirsep1$hpath"
    fopen fh "$hn"
    if $fh > 0
      break
    end
    echo Ignoring source file "$fn" as "$hn" was not found.
  end
end

if $fh > 0
   fclose $fh
   set fn_main="$stem$dirsep1$mainfile"
else
   echo Can not find C++ source file $shimfile
   quit
end

if $windows

   set incdir=ngspice
   shell xcopy /i "$stem$dirsep1$incdir" "$objdir$dirsep1$incdir"
   setcs include="--CFLAGS -I."


   shell copy "$fn" "$objdir"
else

   strstr off "$stem" "."
   if $off <> 0
      setcs include="--CFLAGS -I$stem"
   else
      setcs include="--CFLAGS -I..$dirsep1$stem"
   end
end
if $timing = 0
  setcs cflags="--CFLAGS -DWITH_TIMING ""$cflags"
end
shell $run_verilator --Mdir $objdir --prefix $prefix $include $cflags
+ --cc --build --exe
+ $fn_main $fn $argv

strcmp bad "$shellstatus" "0"

if $bad = 0

   set   v_objs="$objdir$dirsep1$shimobj $objdir/verilated.o $objdir/verilated_threads.o"
   if $timing = 0
      set v_objs="$v_objs $objdir/verilated_timing.o"
   end
   setcs tail="__ALL.a"
   setcs v_lib="$objdir/$prefix$tail"          // Like Vlng__ALL.a

   shell g++ --shared $v_objs $v_lib -pthread -lpthread -o $soname
else

   if $windows = 0
      quit
   end

   set msvcfile=MSVC.CMD
   let i=1
   repeat $#sourcepath
     set stem="$sourcepath[$&i]"
     let i = i + 1
     set fn="$stem$dirsep1$msvcfile"
     fopen fh $fn
     if $fh > 0
        break
     end
   end
   if $fh > 0
     fclose $fh
   else
      echo Can not find build file $msvcfile
      quit
   end

   echo Building with MSVC compiler, CL.EXE.
   cd $objdir
   shell $fn
   cd ..
end
quit
