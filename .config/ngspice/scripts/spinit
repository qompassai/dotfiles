alias acct rusage all
set x11lineararcs
set rndseed=12
set filetype=ascii
set ngdebug
set askquit
et num_threads=8
unset osdi_enabled
if $?xspice_enabled
 codemodel /usr/lib/ngspice/spice2poly.cm
 codemodel /usr/lib/ngspice/analog.cm
 codemodel /usr/lib/ngspice/digital.cm
 codemodel /usr/lib/ngspice/xtradev.cm
 codemodel /usr/lib/ngspice/xtraevt.cm
 codemodel /usr/lib/ngspice/table.cm
 codemodel /usr/lib/ngspice/tlines.cm

end

if $?osdi_enabled
 osdi /usr/lib/ngspice/asmhemt.osdi
 osdi /usr/lib/ngspice/bjt504t.osdi
