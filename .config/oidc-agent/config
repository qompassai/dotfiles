  },
  "oidc-add": {
    "store-pw": false,
    "prompt": "cli",
    "pw-prompt": "cli",
    "debug_logging": false
  },
  "oidc-token": {
    "default_min_lifetime": 0,
    "default_mytoken_profile": "web-default",
    "debug_logging": false
