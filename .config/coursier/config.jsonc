	"repositories": [
		"central",
		"https://oss.sonatype.org/content/repositories/releases"
	],
	"cache": {
		"location": "${HOME}/.cache/coursier"
	},
	"jvm": {
		"options": ["-Xmx2G", "-Dfile.encoding=UTF-8"]
	}
