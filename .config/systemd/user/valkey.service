[Unit]
Description=Qompass AI Valkey Server
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'export VALKEY_PASSWORD=$(pass show valkey/password); export VALKEY_TLS_CERT_PATH=$(pass show valkey/tls-cert-path); export VALKEY_TLS_KEY_PATH=$(pass show valkey/tls-key-path); export VALKEY_CA_CERT_PATH=$(pass show valkey/ca-cert-path)'
ExecStart=/usr/bin/valkey-server /home/phaedrus/.config/valkey/valkey.conf
Environment="VALKEY_PASSWORD=%i"
EnvironmentFile=-/home/phaedrus/.config/valkey/secrets.env
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

