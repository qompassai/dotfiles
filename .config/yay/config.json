{
    "answerclean": "None",
    "aururl": "https://aur.archlinux.org",
    "aurrpcurl": "https://aur.archlinux.org/rpc?",
    "batchinstall": true,
    "bottomup": true,
    "buildDir": "$XDG_CACHE_HOME/yay",
    "cleanAfter": true,
    "cleanmenu": true,
    "combinedupgrade": true,
    "completionrefreshtime": 10,
    "debug": false,
    "devel": true,
    "diffmenu": false,
    "doubleconfirm": false,
    "editmenu": false,
    "editor": "nvim",
    "editorflags": "-E",
    "gitbin": "git",
    "gitflags": "-c core.sshCommand=ssh",
    "gpgbin": "gpg",
    "gpgflags": "",
    "keepSrc": false,
    "makepkgbin": "makepkg",
    "makepkgconf": "$XDG_CONFIG_HOME/pacman/makepkg.conf",
    "maxconcurrentdownloads": 15,
    "mflags": "--nocheck --syncdeps --clean --noconfirm",
    "pacmanbin": "pacman",
    "pacmanconf": "$XDG_CONFIG_HOME/pacman/pacman.conf",
    "pgpfetch": true,
    "provides": true,
    "ramver": "",
    "rebuild": "yes",
    "redownload": "yes",
    "removemake": "yes",
    "requestsplitn": 300,
    "rpc": true,
    "searchby": "name-desc",
    "separatesources": true,
    "singlelineresults": false,
    "sortby": "votes",
    "sudobin": "sudo",
    "sudoflags": "-E",
    "sudoloop": true,
    "timeupdate": true,
    "useask": false,
    "version": "12.5.7"
}
