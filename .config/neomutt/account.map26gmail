set postponed = "+[Gmail]/Drafts"
set realname = "Matt A. Porter"
set record = "+[Gmail]/Sent Mail"
set sendmail = "/usr/bin/msmtp -a gmail-map26"
set trash="+Trash"
set use_from = yes
