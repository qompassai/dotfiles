source ~/.config/neomutt/account.qompassai
bind index \ct tag-prefix
folder-hook  "set sort=threads"
folder-hook .mail/aflabs source ~/.config/neomutt/account.aflabs
folder-hook .mail/gmail/foamedgmail source ~/.config/neomutt/account.foamedmap
folder-hook .mail/gmail/matt.a.porter26 source ~/.config/neomutt/account.map26gmail
folder-hook .mail/qompassai source ~/.config/neomutt/account.qompassai
folder-hook .mail/wsu source ~/.config/neomutt/account.wsu
macro index S ":set query_command='notmuch search --output=files '%s''\n<enter-command>set wait_key=no\n<enter-command>push <query><enter>"
mailboxes \
  +aflabs/INBOX \
  +gmail/foamedgmail/INBOX \
  +gmail/matt.a.porter26/INBOX \
  +qompassai/INBOX \
  +wsu/INBOX
mime_lookup application/ics
mailboxes `notmuch search --output=files tag:inbox`
mailboxes `notmuch search --output=files tag:unread`
mailboxes `notmuch search --output=files tag:flagged`
mailboxes `notmuch search --output=files tag:sent`
mailboxes `notmuch search --output=files tag:archive`

set autocrypt = yes
set collapse_unread = yes
set confirmappend = yes
set crypt_replyencrypt = yes
set crypt_replysign = yes
set crypt_use_gpgme = yes
set delete = ask-yes
set editor = "nvim"
set envelope_from = yes
set fast_reply = yes
set folder = "~/.local/share/mail"
set forward_quote = yes
set from = "foamedmap@gmail.com"
set folder = "~/.local/share/mail/gmail"
set imap_user = "map@qompass.ai"
set imap_pass="<exec:pass show mail/pass>"
set imap_keepalive = 900
set include = yes
set index_format = "%4C %Z %{%b %d} %-15.15F (%4l) %s"
set mail_check = 60
set markers = no
set mbox_type = Maildir
set move = no
set pager_index_lines = 10
set pager_stop = yes
set pipe_decode = yes
set pgp_use_gpg_agent = yes
set postponed = "+[Gmail]/Drafts"
set quit = ask-yes
set reverse_name = yes
set realname = "Matt A. Porter"
set record = "+[Gmail]/Sent Mail"
set sendmail="/usr/bin/msmtp"
set sendmail_wait = 30
set sidebar_short_path = yes
set sidebar_visible = yes
set sidebar_width = 30
set smart_wrap = yes
set sort = threads
set sort_aux = reverse-last-date-received
set spoolfile = "+Inbox"
set ssl_force_tls = yes
set ssl_starttls = yes
set ssl_verify_dates = yes
set ssl_verify_host = yes
set status_format = "%r %f %t %n"
set strict_threads = yes
set thread_received = yes
set tilde = yes
set timeout = 10
set trash = "+[Gmail]/Trash"
set use_envelope_from = yes
set use_from = yes
set visual = "nvim"
