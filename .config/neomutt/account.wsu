set from = "matthew.a.porter@wsu.edu"
set realname = "Matt A. Porter"
set folder = "~/.local/share/mail/wsu"
set record = "+Sent"
set postponed = "+Drafts"
set trash = "+Trash"
set envelope_from = yes
set use_from = yes
set sendmail = "/usr/bin/msmtp -a wsu"

