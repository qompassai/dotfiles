# References: https://www.gnu.org/software/wget/manual/wget.html#Startup-File
backup_converted = off
ca_certificate=/etc/ssl/certs/ca-certificates.crt
dirstruct = off
dot_style = default
follow_ftp = on
#ftp_proxy = http://proxy.yoyodyne.com:18023/
#header = From: "(pass show wget/fromheader)"
header = Accept-Language: en
#https_proxy = http://proxy.yoyodyne.com:18023/
#http_proxy = http://proxy.yoyodyne.com:18023/
#httpsonly = on
quota = inf
tries = 20
reclevel = 5
passive_ftp = off
waitretry = 10
timestamping = off
robots = on
wait = 0
recursive = on
prefer-family = IPv6
iri = off
localencoding = UTF-8
remoteencoding = UTF-8
secureprotocol = auto
use_proxy = on
