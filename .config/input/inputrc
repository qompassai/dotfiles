set convert-meta off
set input-meta on
set meta-flag on
set output-meta on
$if mode=vi
"\e[1;5C": forward-word
"\e[1;5D": backward-word
"\e[1~": beginning-of-line
"\e[2~": quoted-insert
"\e[3~": delete-char
"\e[4~": end-of-line
"\e[5C": forward-word
"\e[5D": backward-word
"\e[5~": beginning-of-history
"\e[6~": end-of-history
"\e[7~": beginning-of-line
"\e[8~": end-of-line
"\e\e[C": forward-word
"\e\e[D": backward-word
"\e[F": end-of-line
"\e[H": beginning-of-line
"\eOF": end-of-line
"\eOH": beginning-of-line
$endif
