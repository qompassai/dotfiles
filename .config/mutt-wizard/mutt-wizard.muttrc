# vim: filetype=neomuttrc
# /qompassai/dotfiles/.config/mutt-wizard/mutt-wizard.muttrc
# Qompass AI Mutt-Wizard Config
# Copyright (C) 2025 Qompass AI, All rights reserved
############################################################
set crypt_autosign = yes
set crypt_opportunistic_encrypt = yes
set date_format="%y/%m/%d %I:%M%p"
set display_filter = "tac | sed '/\\\[-- Autoview/,+1d' | tac"
set fcc_attach
set fast_reply
set forward_format = "Fwd: %s"
set forward_quote
set include
set index_format="%2C %Z %?X?A& ? %D %-15.15F %s (%-4.4c)"
set mail_check=60
set mail_check_stats
set mailcap_path = $HOME/.config/mutt/mailcap:/usr/share/mutt-wizard/mailcap:$mailcap_path
set markers = no
set mark_old = no
set mime_forward = yes
set mime_type_query_command = "file --mime-type -b %s"
set pgp_default_key  = 'ph43dru5@keemail.me'
set pgp_self_encrypt = yes
set query_command = "abook --mutt-query '%s'"
set rfc2047_parameters = yes
set reverse_name
set sleep_time = 0
set sidebar_format = '%D%?F? [%F]?%* %?N?%N/? %?S?%S?'
set sidebar_next_new_wrap = yes
set sidebar_short_path = yes
set sidebar_visible = yes
set sidebar_width = 20
set smtp_authenticators = 'gssapi:login'
set sort = 'reverse-date'
set wait_key = no
auto_view application/pgp-encrypted
auto_view text/html
alternative_order text/plain text/enriched text/html
bind attach <return> view-mailcap
bind attach l view-mailcap
bind browser h goto-parent
bind browser l select-entry
bind editor <space> noop
bind editor <Tab> complete-query
bind index \031 previous-undeleted
bind index \005 next-undeleted
bind index \Cf noop
bind index G last-entry
bind index D delete-message
bind index L limit
bind index O "<shell-escape>mw -Y<enter>" "run mw -Y to sync all mail"
bind index U undelete-message
bind index h noop
bind index l display-message
bind index,pager C noop
bind index,pager H view-raw-message
bind index,pager M noop
bind index,pager R group-reply
bind index,pager S sync-mailbox
bind index,pager g noop
bind index,pager i noop
bind index,pager j next-entry
bind index,pager k previous-entry
bind index,pager,browser d half-down
bind index,pager,browser u half-up
bind index,pager,browser gg top-page
bind index,pager,browser G bottom-page
bind index,query <space> tag-entry
bind pager \031 previous-line
bind pager \005 next-line
bind pager,attach h exit
bind pager j next-line
bind pager k previous-line
bind pager l view-attachments
bind index,pager \Cj sidebar-next
bind index,pager \Ck sidebar-prev
bind index,pager,B sidebar-toggle-visible
bind index,pager \Cn sidebar-next-new
bind index,pager \Co sidebar-open
bind index,pager \Cp sidebar-prev-new
macro browser h '<change-dir><kill-line>..<enter>' "Go to parent folder"
macro index A "<limit>all\n" "show all messages (undo limit)"
macro index \Cr "T~U<enter><tag-prefix><clear-flag>N<untag-pattern>.<enter>" "mark all messages as read"
macro index \Cf "<enter-command>unset wait_key<enter><shell-escape>printf 'Enter a search term to find with notmuch: '; read x; echo \$x >~/.cache/mutt_terms<enter><limit>~i \"\`notmuch search --output=messages \$(cat ~/.cache/mutt_terms) | head -n 600 | perl -le '@a=<>;s/\^id:// for@a;$,=\"|\";print@a' | perl -le '@a=<>; chomp@a; s/\\+/\\\\+/ for@a;print@a' \`\"<enter>" "show only messages matching a notmuch pattern"
macro index O "<shell-escape>mw -Y<enter>" "run mw -Y to sync all mail"
macro index,pager a "<enter-command>set my_pipe_decode=\$pipe_decode pipe_decode<return><pipe-message>abook --add-email<return><enter-command>set pipe_decode=\$my_pipe_decode; unset my_pipe_decode<return>" "add the sender address to abook"
macro index,pager Ca ";<copy-message>=Archive<enter>" "copy mail to archive"
macro index,pager Cd ";<copy-message>=Drafts<enter>" "copy mail to drafts"
macro index,pager Ci ";<copy-message>=INBOX<enter>" "copy mail to inbox"
macro index,pager Cj ";<copy-message>=Junk<enter>" "copy mail to junk"
macro index,pager Cs ";<copy-message>=Sent<enter>" "copy mail to sent"
macro index,pager Ct ";<copy-message>=Trash<enter>" "copy mail to trash"
macro index,pager Ma ";<save-message>=Archive<enter>" "move mail to archive"
macro index,pager Md ";<save-message>=Drafts<enter>" "move mail to drafts"
macro index,pager Mi ";<save-message>=INBOX<enter>" "move mail to inbox"
macro index,pager Mj ";<save-message>=Junk<enter>" "move mail to junk"
macro index,pager Ms ";<save-message>=Sent<enter>" "move mail to sent"
macro index,pager Mt ";<save-message>=Trash<enter>" "move mail to trash"
macro index,pager ga "<change-folder>=Archive<enter>" "go to archive"
macro index,pager gd "<change-folder>=Drafts<enter>" "go to drafts"
macro index,pager gj "<change-folder>=Junk<enter>" "go to junk"
macro index,pager gi "<change-folder>=INBOX<enter>" "go to inbox"
macro index,pager gs "<change-folder>=Sent<enter>" "go to sent"
macro index,pager gt "<change-folder>=Trash<enter>" "go to trash"
color attachment white default
color bold black default
color body brightblue default "(https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9]+"
color body brightblue default "^# \.*"
color body brightcyan default "^## \.*"
color body brightcyan default "[;:][-o][)/(|]"
color body brightcyan default "[;:][)(|]"
color body brightcyan default "[ ][*][^*]*[*][ ]?"
color body brightcyan default "[ ]?[*][^*]*[*][ ]"
color body brightcyan default "[ ][*][^*]*[*][ ]?"
color body brightcyan default "[ ]?[*][^*]*[*][ ]"
color body brightgreen default "^### \.*"
color body brightmagenta default
color body brightred default "[\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+"
color body brightyellow red "^gpg: BAD signature from.*"
color body brightyellow default "^gpg: "
color body cyan default "(Good signature)"
color body green default "\`[^\`]*\`"
color body red default "(BAD signature)"
color body red default "([a-z][a-z0-9+-]*://(((([a-z0-9_.!~*'();:&=+$,-]|%[0-9a-f][0-9a-f])*@)?((([a-z0-9]([a-z0-9-]*[a-z0-9])?)\.)*([a-z]([a-z0-9-]*[a-z0-9])?)\.?|[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)(:[0-9]+)?)|([a-z0-9_.!~*'()$,;:@&=+-]|%[0-9a-f][0-9a-f])+)(/([a-z0-9_.!~*'():@&=+$,-]|%[0-9a-f][0-9a-f])*(;([a-z0-9_.!~*'():@&=+$,-]|%[0-9a-f][0-9a-f])*)*(/([a-z0-9_.!~*'():@&=+$,-]|%[0-9a-f][0-9a-f])*(;([a-z0-9_.!~*'():@&=+$,-]|%[0-9a-f][0-9a-f])*)*)*)?(\\?([a-z0-9_.!~*'();/?:@&=+$,-]|%[0-9a-f][0-9a-f])*)?(#([a-z0-9_.!~*'();/?:@&=+$,-]|%[0-9a-f][0-9a-f])*)?|(www|ftp)\\.(([a-z0-9]([a-z0-9-]*[a-z0-9])?)\.)*([a-z]([a-z0-9-]*[a-z0-9])?)\\.?(:[0-9]+)?(/([-a-z0-9_.!~*'():@&=+$,]|%[0-9a-f][0-9a-f])*(;([-a-z0-9_.!~*'():@&=+$,]|%[0-9a-f][0-9a-f])*)*(/([-a-z0-9_.!~*'():@&=+$,]|%[0-9a-f][0-9a-f])*(;([-a-z0-9_.!~*'():@&=+$,]|%[0-9a-f][0-9a-f])*)*)*)?(\\?([-a-z0-9_.!~*'();/?:@&=+$,]|%[0-9a-f][0-9a-f])*)?(#([-a-z0-9_.!~*'();/?:@&=+$,]|%[0-9a-f][0-9a-f])*)?)[^].,:;!)? \t\r\n<>\"]"
color body brightblack default "^gpg: Good signature .*"
color body yellow default "^(\t| )*(-|\\*) \.*"
color error red default
color hdrdefault brightgreen default
color header blue default ".*"
color header brightcyan default "^Subject"
color header brightmagenta default "^From"
color header brightwhite default "^(CC|BCC)"
color index yellow default '.*'
color index brightyellow black "~N"
color index brightyellow blue "~T"
color index_author brightred black "~N"
color index_author brightred blue "~T"
color index_number blue default
color index_subject cyan default '.*'
color index_subject brightcyan black "~N"
color index_subject brightcyan blue "~T"
color markers red white
color message cyan default
color normal brightyellow default
color normal default default
color sidebar_divider brightblack black
color sidebar_flagged red black
color sidebar_highlight red default
color sidebar_new green black
color status brightyellow black
color quoted green default
color quoted1 blue default
color quoted2 cyan default
color quoted3 yellow default
color quoted4 red default
color quoted5 brightred default
color signature brightgreen default
color tilde black default
mono bold bold
mono error bold
mono indicator reverse
mono underline underline
mono body bold "^gpg: Good signature"
mono body bold "^gpg: BAD signature from.*"
