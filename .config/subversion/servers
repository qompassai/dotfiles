# References: http://svnbook.red-bean.com/nightly/en/svn.serverconfig.netmodel.html#svn.tour.initial.authn-cache-purge
[groups]
group1 = *.collab.net
username = "$(pass show subversion/user)"
[global]
http-proxy-exceptions = "$(pass show subversion/httpproxexcep)"
http-proxy-host = "$(pass show subversion/httpproxhost)"
http-proxy-port = "$(pass show subversion/httpproxyport)"
http-proxy-username = "$(pass show subversion/httpuser)"
http-proxy-password = "$(pass show subversion/httppass)"
http-compression = auto
ssl-authority-files = "$(pass show subversion/sslauthf)"
store-passwords = no
store-ssl-client-cert-pp = no
