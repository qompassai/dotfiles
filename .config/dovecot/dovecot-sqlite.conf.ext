driver = sqlite
connect = /home/phaedrus/.config/dovecot/virtual_users.db
default_pass_scheme = SHA512-CRYPT

password_query = SELECT email as user, password FROM virtual_users WHERE email='%u'
user_query = SELECT '/home/phaedrus/.mail/%d/%n' AS home, 5000 AS uid, 5000 AS gid FROM virtual_users WHERE email='%u'
