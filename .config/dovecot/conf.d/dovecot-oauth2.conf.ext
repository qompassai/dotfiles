# /qompassai/dotfiles/.config/dovecot/conf.d/oauth2.conf.ext
# Qompass AI Dovecot Oauth2 Config
# Copyright (C) 2025 Qompass AI, All rights reserved
###########################################################
# The URL where Dovecot will POST the access_token for validation:
introspection_url = https://oauth-provider.com/introspect
# POST or GET mode—modern OAuth2 APIs use POST:
introspection_mode = post
client_id = your-client-id
client_secret = your-client-secret
# TLS root certificate (for validating the HTTPS endpoint)
# Use the system default CA bundle (on Arch/Ubuntu/etc):
tls_ca_cert_file = /etc/ssl/certs/ca-certificates.crt
username_attribute = email
require_active_claim = yes
# allowed_issuers = https://accounts.google.com
# introspection_extra = "scope=mail.readonly"
# debug = yes
