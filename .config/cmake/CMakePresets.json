{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 50,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "zig-default",
      "displayName": "Zig + glibc + safe",
      "description": "Default Zig build with glibc and safe optimizations",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/zig-default",
      "toolchainFile": "${sourceDir}/cmake/zig-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ZIG_CPU": "x86_64",
        "ZIG_LIBC": "glibc",
        "ZIG_OPTIMIZE_LEVEL": "safe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "zig-musl-release",
      "displayName": "Zig + musl + ReleaseFast",
      "description": "Cross-compile using musl libc and fast optimizations",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/zig-musl-release",
      "toolchainFile": "${sourceDir}/cmake/zig-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ZIG_CPU": "x86_64",
        "ZIG_LIBC": "musl",
        "ZIG_OPTIMIZE_LEVEL": "ReleaseFast",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "zig-debug",
      "displayName": "Zig Debug Build",
      "description": "Debug build using Zig with glibc",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/zig-debug",
      "toolchainFile": "${sourceDir}/cmake/zig-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ZIG_CPU": "x86_64",
        "ZIG_LIBC": "glibc",
        "ZIG_OPTIMIZE_LEVEL": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "zig-default",
      "description": "Build the default Zig preset",
      "jobs": 0
    },
    {
      "name": "musl-release",
      "configurePreset": "zig-musl-release",
      "description": "Build Zig preset with musl and ReleaseFast",
      "jobs": 0
    },
    {
      "name": "debug",
      "configurePreset": "zig-debug",
      "description": "Build with Debug config using Zig",
      "jobs": 0
    }
  ]
}

