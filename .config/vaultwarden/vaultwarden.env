#################################################
# shellcheck disable=SC2034,SC2148
# References: https://bitwarden.com/host | https://docs.diesel.rs/2.1.x/diesel/mysql/struct.MysqlConnection.html | https://docs.diesel.rs/2.1.x/diesel/pg/struct.PgConnection.html | https://www.postgresql.org/docs/current/libpq-connect.html#LIBPQ-CONNSTRING | https://crates.io/crates/cron | https://github.com/dani-garcia/vaultwarden/wiki/Enabling-Mobile-Client-push-notification | https://crontab.guru |  https://github.com/dani-garcia/vaultwarden/wiki/Enabling-HTTPS | https://haveibeenpwned.com/API/Key | https://github.com/dani-garcia/vaultwarden/wiki/Enabling-HTTPS | https://github.com/dani-garcia/vaultwarden/wiki/Enabling-HTTPS | https://en.wikipedia.org/wiki/Reserved_IP_addresses | https://docs.rs/chrono/latest/chrono/format/strftime | https://github.com/dani-garcia/vaultwarden/wiki/Enabling-admin-page#secure-the-admin_token | https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Content-Security-Policy/frame-ancestors | https://tools.ietf.org/html/rfc6238 | https://github.com/dani-garcia/vaultwarden/wiki/Enabling-admin-page#secure-the-admin_token  https://upgrade.yubico.com/getapikey/ | https://rocket.rs/v0.5/guide/configuration/ | https://tools.ietf.org/html/rfc6238 | https://haveibeenpwned.com/API/Key | https://docs.rs/chrono/latest/chrono/format/strftime | https://tools.ietf.org/html/rfc6238

ADMIN_RATELIMIT_MAX_BURST=3
ADMIN_RATELIMIT_SECONDS=300
ADMIN_SESSION_LIFETIME=20
ADMIN_TOKEN="$(pass show vw/admintoken)"
ALLOWED_CONNECT_SRC=""
ALLOWED_IFRAME_ANCESTORS=
ATTACHMENTS_FOLDER=data/attachments
AUTH_REQUEST_PURGE_SCHEDULE="30 * * * * *"
DATABASE_CONN_INIT=
DATABASE_MAX_CONNS=10
DATABASE_TIMEOUT=30
DATABASE_URL="$(pass show vw/dburl)"
DATA_FOLDER=${XDG_DATA_HOME:-/var/lib/vaultwarden}
DB_CONNECTION_RETRIES=15
ENABLE_DB_WAL=true
ENABLE_WEBSOCKET=true
DOMAIN=http://localhost
DUO_CONTEXT_PURGE_SCHEDULE="30 * * * * *"
EMAIL_2FA_AUTO_FALLBACK=false
EMAIL_2FA_ENFORCE_ON_VERIFIED_INVITE=false
EMAIL_ATTEMPTS_LIMIT=3
EMAIL_CHANGE_ALLOWED=true
EMAIL_EXPIRATION_TIME=600
EMAIL_FROM_NAME=Vaultwarden
EMAIL_TOKEN_SIZE=6
EMERGENCY_ACCESS_ALLOWED=true
EMERGENCY_NOTIFICATION_REMINDER_SCHEDULE="0 3 * * * *"
EMERGENCY_REQUEST_TIMEOUT_SCHEDULE="0 7 * * * *"
ENABLE_DB_WAL=true
ENABLE_WEBSOCKET=true
ENFORCE_SINGLE_ORG_WITH_RESET_PW_POLICY=false
EVENT_CLEANUP_SCHEDULE="0 10 0 * * *"
EXPERIMENTAL_CLIENT_FEATURE_FLAGS=fido2-vault-credentials
EXPORT_ATTACHMENTS_FOLDER=${XDG_CACHE_HOME:-data/export_attachments}
EXTENDED_LOGGING=true
HIBP_API_KEY="$(pass show vw/hibpkey)"
HTTP_REQUEST_BLOCK_NON_GLOBAL_IPS=true
HTTP_REQUEST_BLOCK_REGEX='^(192\.168\.0\.[0-9]+|192\.168\.1\.[0-9]+)$'
ICON_CACHE_FOLDER=${XDG_CACHE_HOME:-data/icon_cache}
ICON_CACHE_NEGTTL=259200
ICON_CACHE_TTL=2592000
ICON_DOWNLOAD_TIMEOUT=10
ICON_REDIRECT_CODE=302
ICON_SERVICE=internal
INCOMPLETE_2FA_SCHEDULE="30 * * * * *"
INCOMPLETE_2FA_TIME_LIMIT=3
INCREASE_NOTE_SIZE_LIMIT=true
INVITATION_EXPIRATION_HOURS=120
INVITATIONS_ALLOWED=true
IP_HEADER=X-Real-IP
JOB_POLL_INTERVAL_MS=30000
LICENSE_PATH=${XDG_CONFIG_HOME:-/vaultwarden//license/vaultwarden.lic}
LOG_FILE=/var/log/vaultwarden.log
LOG_LEVEL=info 
LOG_TIMESTAMP_FORMAT="%Y-%m-%d %H:%M:%S.%3f"
MUTUAL_TLS_ENABLED=false
ORG_ATTACHMENT_LIMIT=
ORG_CREATION_USERS="$(pass show vw/orgcreateuser)"
ORG_EVENTS_ENABLED=false
ORG_GROUPS_ENABLED=true
PASSWORD_HINTS_ALLOWED=false
PASSWORD_ITERATIONS=600000
PUSH_ENABLED=false
PUSH_IDENTITY_URI=https://identity.bitwarden.eu
PUSH_INSTALLATION_ID="$(pass show vw/pushinstallid)"
PUSH_INSTALLATION_KEY="$(pass show vw/pushinstallkey)"
PUSH_RELAY_URI=https://api.bitwarden.eu
RELOAD_TEMPLATES=false
REQUIRE_DEVICE_EMAIL=false
SEND_PURGE_SCHEDULE="0 5 * * * *"
SENDS_ALLOWED=true
SENDS_FOLDER=data/sends
SHOW_PASSWORD_HINT=false
SIGNUPS_ALLOWED=true
SIGNUPS_DOMAINS_WHITELIST="$(pass show vw/whitelist)"
SIGNUPS_VERIFY=true
SIGNUPS_VERIFY_RESEND_LIMIT=6
SIGNUPS_VERIFY_RESEND_TIME=3600
SMTP_ACCEPT_INVALID_CERTS=false
SMTP_ACCEPT_INVALID_HOSTNAMES=false
SMTP_AUTH_MECHANISM="Login, Xoauth2"
SMTP_DEBUG=false
SMTP_EMBED_IMAGES=true
SMTP_EXPIRATION_TIME=600
SMTP_FROM="$(pass show vw/smtpfrom)"
SMTP_FROM_NAME=Vaultwarden
SMTP_HOST="$(pass show vw/smtphost)"
SMTP_PASSWORD="$(pass show vw/smtppass)"
SMTP_PORT="$(pass show vw/smtpport)"
SMTP_SECURITY=starttls
SMTP_TIMEOUT=15
SMTP_USERNAME="$(pass show vw/smtpuser)"
SYSLOG_ENABLED=false
TEMPLATES_FOLDER=${XDG_CONFIG_HOME:-data/templates}
TMP_FOLDER=data/tmp
TRASH_AUTO_DELETE_DAYS=7
TRASH_PURGE_SCHEDULE="0 5 0 * * *"
USER_ATTACHMENT_LIMIT=
USER_SEND_LIMIT=
USE_SENDMAIL=false
WEB_VAULT_ENABLED=false
WEB_VAULT_FOLDER=/usr/share/webapps/vaultwarden-web
YUBICO_CLIENT_ID="$(pass show yubiclientid)"
YUBICO_SECRET_KEY="$(pass show vw/yubisk)"
YUBICO_SERVER="$(pass show vw/yubiserver)"
