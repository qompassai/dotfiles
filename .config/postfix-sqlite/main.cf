# /qompassai/dotfiles/.config/postfix-sqlite/main.cf
# Qompass AI Postfix-Sqlite3 Config
# Copyright (C) 2025 Qompass AI, All rights reserved
####################################################
# Modern compatibility mode
compatibility_level = 3.10

# Network/Protocol settings
inet_interfaces = all
inet_protocols = all

# Enable mail delivery to all interfaces (IPv4 and IPv6)
myhostname = mail.qompass.ai
mydomain = qompass.ai
myorigin = $mydomain

# Mail for these domains is accepted (via SQLite maps)
virtual_mailbox_domains = sqlite:/home/phaedrus/.config/postfix-sqlite/virtual_domains.cf
virtual_mailbox_maps = sqlite:/home/phaedrus/.config/postfix-sqlite/virtual_users.cf
virtual_alias_maps = sqlite:/home/phaedrus/.config/postfix-sqlite/virtual_aliases.cf

# Local recipient maps are left empty for pure virtual hosting
local_recipient_maps =

# SMTP and mail submission service
smtpd_banner = $myhostname ESMTP
biff = no

# Restrict relaying
mynetworks_style = host
mynetworks = 127.0.0.0/8, [::1]/128

# Outbound relay (comment unless you want to relay via your ISP/Upstream)
#relayhost = [smtp.your-isp.com]

# Delivery to Dovecot via LMTP (required for virtual mailboxes)
virtual_transport = lmtp:unix:private/dovecot-lmtp

#smtpd_tls_cert_file=/etc/ssl/certs/your-cert.pem
#smtpd_tls_key_file=/etc/ssl/private/your-key.pem
#smtpd_use_tls=yes
#smtpd_tls_security_level = may
#smtp_tls_security_level = may
smtpd_sasl_auth_enable = yes
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_security_options = noanonymous
smtpd_sasl_local_domain = $mydomain

smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

virtual_mailbox_base = /home/phaedrus/.local/share/mail
virtual_minimum_uid = 1000
virtual_uid_maps = static:1000
virtual_gid_maps = static:1000
mail_owner = postfix
setgid_group = postdrop
queue_directory = /home/phaedrus/.local/var/spool/postfix
command_directory = /usr/sbin
daemon_directory = /usr/lib/postfix/bin
data_directory = /var/lib/postfix
html_directory = no
manpage_directory = /usr/share/man
sample_directory = /etc/postfix
readme_directory = /usr/share/doc/postfix
shlib_directory = /usr/lib/postfix
meta_directory = /etc/postfix
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
debug_peer_level = 2
