# Primary configuration for ESP and boot directories
BOOTDIR="/boot"
ESP="/boot"  # Mount ESP directly at /boot instead of /boot/efi
CMDLINE_DIR="/boot"

# Set this to 1 if you want to automatically update the default boot entry
SETNEXT=0

# Specify the correct EFI directory structure for your system
# This ensures files are placed in the right location
EFI_DIR="EFI/ArchLinux"

