# /qompassai/dotfiles/xl2tpd/xl2tpd.conf.server
# Qompass AI X2l2tpd Server Config
# Copyright (C) 2025 Qompass AI, All rights reserved
####################################################

[global]
access control = yes
auth file = /etc/ppp/chap-secrets
debug avp = no
debug network = no
debug packet = no
debug state = no
debug tunnel = no

[lns <name>]
require chap = yes
ppp debug = no
pppoptfile = /etc/ppp/options.l2tpd
require pap = no
assign ip = yes
hostname = <hostname>
ip range = <range>
local ip = <ip>
challenge = no
lac = <lacs>
require authentication = no
