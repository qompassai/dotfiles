# =============================================================================
# Odysseus AI workspace -- environment configuration (odysseus.env)
# =============================================================================
# What this app is:
#   Odysseus is a local-first AI workspace (chat, RAG over your documents,
#   email, calendar, gallery, automations) served as a web UI by uvicorn.
#   This dotenv file configures it: which LLM to talk to, where search and
#   the vector database live, auth, OAuth, upload caps, and Docker Compose
#   overlays. ELI5: one labeled box per setting; the app reads the boxes
#   when it starts.
#
# Where this file lives on a real system:
#   - AUR user service:  ~/.config/odysseus-ai/odysseus.env
#     (EnvironmentFile=-%h/.config/odysseus-ai/odysseus.env)
#   - AUR system service: /etc/odysseus-ai/odysseus.env
#     (the AUR package installs .env.example there as odysseus.env)
#   In this dotfiles repo it is stored as .config/odysseus-ai/odysseus.env,
#   which IS the real user-service path.
#
# Doc references (accessed 2026-09-28):
#   1. Upstream repository: https://github.com/odysseus-dev/odysseus
#   2. Setup guide: https://github.com/odysseus-dev/odysseus/blob/dev/website/setup.md
#   3. AUR package (PKGBUILD service units, launcher wrapper honoring
#      ODYSSEUS_HOST/ODYSSEUS_PORT, install of .env.example):
#      https://aur.archlinux.org/packages/odysseus-ai
#   4. AUR-pinned source, commit cf4e240ad1622da6a904f496b19d656a2b9c6393
#      (.env.example quoted below; src/ and setup.py for extra variables):
#      https://github.com/pewdiepie-archdaemon/odysseus
#
# Notes / unverifiable details:
#   - Every variable from the AUR-pinned .env.example is set explicitly
#     below, including ones the example leaves commented (they now carry
#     their documented defaults). Variables are alphabetical within
#     sections; sections mirror .env.example, then extras.
#   - `KEY=` (empty value) means "unset / use the built-in default".
#     Secrets (API keys, OAuth secrets, admin password) are EMPTY here on
#     purpose -- fill them in on the machine, never commit real ones.
#   - "Advanced tuning" variables are NOT in .env.example; their defaults
#     were read from the pinned source (file:line noted per variable).
#     Demo-script-only variables (DEMO_IMAP_*, DEMO_ALLOW_WIPE, used by
#     scripts/demo_email/seed_demo_emails.py) are intentionally omitted.
#   - ODYSSEUS_HOST / ODYSSEUS_PORT are honored by the AUR launcher
#     wrapper (/usr/bin/odysseus-ai), defaulting to 127.0.0.1:7000.
#   - APP_PORT is the in-app setting; keep it and ODYSSEUS_PORT in sync.
#   - Upstream's default branch has moved on since the AUR-pinned commit;
#     re-check new variables when the package updates.

# ============================================================
# LLM Configuration
# ============================================================
# Primary LLM host (default: localhost).
LLM_HOST=localhost
# Additional LLM hosts, comma-separated (model discovery). Hostnames/IPs
# only; Odysseus scans common serve ports, including Ollama's 11434.
LLM_HOSTS=
# Optional Ollama base URL (in Docker, host Ollama via host.docker.internal).
OLLAMA_BASE_URL=
# Optional LM Studio URL.
LM_STUDIO_URL=
# OpenAI API key (only needed for OpenAI models). Empty = not configured.
OPENAI_API_KEY=
# Research service LLM endpoint.
RESEARCH_LLM_ENDPOINT=
# Extra CA bundle (PEM) for LLM providers whose TLS chain is not in the
# default trust store. Layered ON TOP of the system/certifi bundle;
# verification stays on, the trust set just grows.
LLM_CA_BUNDLE=

# ============================================================
# Search & Web
# ============================================================
# SearXNG instance URL (self-hosted web search).
SEARXNG_INSTANCE=http://localhost:8080
# Optional SearXNG cookie/CSRF secret. Empty = Docker generates one on
# first boot into the searxng-data volume.
SEARXNG_SECRET=

# ============================================================
# Database
# ============================================================
# SQLite database path (default: sqlite:///./data/app.db).
DATABASE_URL=sqlite:///./data/app.db

# ============================================================
# Data directory
# ============================================================
# Move everything under data/ (settings, sessions, database, auth, cache,
# uploads, ...) to another path. Empty = default location.
ODYSSEUS_DATA_DIR=

# ============================================================
# Auth & Security
# ============================================================
# CORS allowed origins (default: localhost-only; restrict to your public
# origin in production).
ALLOWED_ORIGINS=
# Host bind address for the web UI. Keep on loopback unless you
# intentionally want LAN/reverse-proxy access.
APP_BIND=127.0.0.1
# Web UI port (change if something else uses 7000; macOS AirPlay often does).
APP_PORT=7000
# Enable authentication (default: true).
AUTH_ENABLED=true
# Development-only auth bypass for loopback requests. Keep false for
# Docker, LAN, reverse proxy, and any shared deployment.
LOCALHOST_BYPASS=false
# Pre-seed the first admin password during setup. Empty = interactive.
ODYSSEUS_ADMIN_PASSWORD=
# Pre-seed the first admin username (setup.py; default: empty).
ODYSSEUS_ADMIN_USER=
# AUR launcher wrapper: host passed to uvicorn --host (default 127.0.0.1).
ODYSSEUS_HOST=127.0.0.1
# AUR launcher wrapper: port passed to uvicorn --port (default 7000).
ODYSSEUS_PORT=7000
# Mark session cookies Secure. "true" only when served through HTTPS by a
# trusted reverse proxy or private access gateway.
SECURE_COOKIES=false

# ============================================================
# ChromaDB (vector store) & ntfy
# ============================================================
# Docker Compose host-port bind for ChromaDB (loopback-only by default).
CHROMADB_BIND=127.0.0.1
# ChromaDB connection timeout in seconds (src/chroma_client.py:19).
CHROMADB_CONNECT_TIMEOUT=2.0
# ChromaDB service host (manual host run: localhost:8100 via
# `docker run -p 8100:8000 chromadb/chroma`).
CHROMADB_HOST=localhost
# ChromaDB service port.
CHROMADB_PORT=8100
# ntfy base URL (notifications).
NTFY_BASE_URL=http://localhost:8091
# Docker Compose host-port bind for ntfy (loopback-only by default; set to
# your Tailscale IP to expose ntfy there and update NTFY_BASE_URL).
NTFY_BIND=127.0.0.1

# ============================================================
# RAG / Embeddings
# ============================================================
# Embedding API key (if the endpoint needs one).
EMBEDDING_API_KEY=
# Embedding request batch size (src/embeddings.py:58).
EMBEDDING_BATCH_SIZE=8
# Max characters per embedding chunk (src/embeddings.py:59).
EMBEDDING_MAX_CHARS=900
# Embedding model name (must exist at EMBEDDING_URL).
EMBEDDING_MODEL=
# Embedding API endpoint (OpenAI-compatible /v1/embeddings).
# Default: http://{LLM_HOST}:11434/v1/embeddings (Ollama).
EMBEDDING_URL=
# Local fallback embedding cache dir (empty = ~/.cache/fastembed).
FASTEMBED_CACHE_PATH=
# Local fallback embedding model (fastembed/ONNX, ~50MB downloaded on
# first run; used when no HTTP embedding API is available).
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# Google OAuth2 (Google Workspace / .edu email accounts)
# ============================================================
# Create credentials at console.cloud.google.com -> APIs & Services ->
# Credentials: enable the Gmail API, configure the consent screen (scopes:
# https://mail.google.com/ and email), create an OAuth 2.0 Client ID (Web
# application) with redirect URI
# http://localhost:7000/api/email/oauth/google/callback (adjust host/port
# for hosted installs).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Set explicitly for HTTPS/reverse-proxy/hosted deployments; must exactly
# match an authorized redirect URI in the Google client. Local HTTP setups
# may use the callback URL inferred by the application.
GOOGLE_OAUTH_REDIRECT_URI=
# Base URL used for OAuth redirects behind reverse proxies / public
# domains (src/mcp_oauth.py:26). Empty = derived from the request.
OAUTH_REDIRECT_BASE_URL=

# ============================================================
# MCP (Model Context Protocol) & browser automation
# ELI5: these govern the helper browser and tool servers the AI may drive.
# ============================================================
# Custom browser executable path for MCP browser automation (empty = auto).
ODYSSEUS_BROWSER_EXECUTABLE=
# Run the MCP browser with an isolated profile ("1"/true default; set to
# 0/false/no to reuse a normal profile).
ODYSSEUS_BROWSER_ISOLATED=1
# Require the browser MCP cache (empty/false default).
ODYSSEUS_BROWSER_MCP_REQUIRE_CACHE=
# NOTE: default "1" means --no-sandbox IS passed: the MCP helper browser
# runs WITHOUT Chromium's sandbox unless you set this to 0/false/no.
ODYSSEUS_BROWSER_NO_SANDBOX=1
# Disable the built-in MCP servers entirely (1/true/yes).
ODYSSEUS_DISABLE_MCP=
# Comma-separated commands allowed for MCP stdio servers (empty = none
# beyond built-ins; src/agent_tools/admin_tools.py:140).
ODYSSEUS_MCP_ALLOWED_COMMANDS=

# ============================================================
# Model behavior
# ============================================================
# Gate for local-model features (src/llm_core.py:25; default on).
ODYSSEUS_LOCAL_MODEL_GATE=true
# Reasoning effort for Mistral models (src/llm_core.py:1254).
ODYSSEUS_MISTRAL_REASONING_EFFORT=high

# ============================================================
# Background tasks & scheduling
# ============================================================
# Seconds a background browser task may stay active (src/interactive_gate.py).
BACKGROUND_TASK_BROWSER_ACTIVE_SECONDS=45
# Gate background tasks to the foreground (default on).
BACKGROUND_TASK_FOREGROUND_GATE=true
# Max seconds to wait on background tasks (0 = don't wait).
BACKGROUND_TASK_MAX_WAIT_SECONDS=0
# Quiet period in ms before a background task is considered idle (1500).
BACKGROUND_TASK_QUIET_MS=1500
# In-process email pollers (default: on). Set to 0 if driving polling from
# cron/systemd via `scripts/odysseus-mail poll-scheduled` and
# `scripts/odysseus-mail poll-summary`, otherwise both schedulers race on
# the same SQLite database.
ODYSSEUS_INPROCESS_POLLERS=1
# In-process scheduled-task runner (default: on). Set to 0 to let an
# external driver fire scheduled tasks.
ODYSSEUS_INPROCESS_TASKS=1

# ============================================================
# Misc
# ============================================================
# Public base URL of this Odysseus instance (used for OAuth callbacks;
# empty = derived from the request; src/mcp_oauth.py:27).
APP_PUBLIC_URL=
# Base URL for the ChatGPT subscription bridge (empty = disabled).
CHATGPT_SUBSCRIPTION_BASE_URL=
# Enable periodic cleanup of old data (src/constants.py:101; default on).
CLEANUP_ENABLED=true
# Cleanup interval in hours (default: 24).
CLEANUP_INTERVAL_HOURS=24
# Block private IPs when fetching images (false default).
IMAGE_BLOCK_PRIVATE_IPS=false
# Log level for the helper scripts (scripts/odysseus-mail; default WARNING).
LOG_LEVEL=WARNING
# Allow CalDAV sync against private IPs (0/false default).
ODYSSEUS_ALLOW_PRIVATE_CALDAV=0
# Internal base URL override (empty = http://127.0.0.1:{APP_PORT};
# src/constants.py:125).
ODYSSEUS_INTERNAL_BASE=
# Mail attachments directory (empty = <data-dir>/mail-attachments).
ODYSSEUS_MAIL_ATTACHMENTS_DIR=
# Host used by the built-in "run_script" scheduled-task action.
# Empty/local/localhost runs scripts on the app host; set to an SSH host
# alias only if you intentionally want scheduled scripts to run remotely.
ODYSSEUS_SCRIPT_HOST=localhost
# Skip the interactive first-admin prompt in setup.py (any value skips).
ODYSSEUS_SKIP_ADMIN_PROMPT=
# Skip the "run hint" printed by setup.py (any value skips).
ODYSSEUS_SKIP_RUN_HINT=

# ============================================================
# Upload size caps (bytes). All validated and optional; defaults shown.
# An invalid value (non-integer or < 1) fails fast at startup.
# ============================================================
# Chat / agent attachment size cap (10 MB).
ODYSSEUS_CHAT_UPLOAD_MAX_BYTES=10485760
# Email compose attachment cap (25 MB).
ODYSSEUS_EMAIL_COMPOSE_UPLOAD_MAX_BYTES=26214400
# Gallery transform input cap (25 MB).
ODYSSEUS_GALLERY_TRANSFORM_UPLOAD_MAX_BYTES=26214400
# Gallery image upload cap (100 MB).
ODYSSEUS_GALLERY_UPLOAD_MAX_BYTES=104857600
# Calendar .ics import cap (10 MB).
ODYSSEUS_ICS_MAX_BYTES=10485760
# Memory import file cap (10 MB).
ODYSSEUS_MEMORY_IMPORT_MAX_BYTES=10485760
# Personal document upload cap (25 MB).
ODYSSEUS_PERSONAL_UPLOAD_MAX_BYTES=26214400
# Speech-to-text audio cap (25 MB).
ODYSSEUS_STT_MAX_AUDIO_BYTES=26214400

# ============================================================
# Docker Compose
# ELI5: these pick which compose files get layered and who owns the
# Docker/GPU sockets. Compose merges the files left-to-right.
# ============================================================
# App data volume path (./data).
APP_DATA_DIR=./data
# App logs volume path (./logs).
APP_LOGS_DIR=./logs
# Colon-separated compose files (native `docker compose` feature).
# GPU: pick ONE of the commented lines, or leave all commented for CPU.
#   NVIDIA (needs nvidia-container-toolkit on the host):
#   COMPOSE_FILE=docker-compose.yml:docker/gpu.nvidia.yml
#   AMD ROCm (needs ROCm drivers + render group GID below):
#   COMPOSE_FILE=docker-compose.yml:docker/gpu.amd.yml
# Host Docker socket access (explicit opt-in, high-trust: raw socket access
# can grant broad control over the host Docker daemon):
#   COMPOSE_FILE=docker-compose.yml:docker/host-docker.yml
COMPOSE_FILE=
# Host docker group's numeric GID (for the host-docker overlay).
DOCKER_GID=
# Set true inside the container by docker/host-docker.yml; keep paired with
# the socket overlay -- setting it alone is not sufficient.
ODYSSEUS_ENABLE_HOST_DOCKER=
# Render group GID for the AMD ROCm GPU overlay
# (find with: getent group render | cut -d: -f3).
RENDER_GID=
