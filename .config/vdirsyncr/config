[general]
status_path = "~/.vdirsyncer/status/"

[pair qompass]
a = "qompass_local"
b = "qompass_remote"
collections = ["from a", "from b"]

[pair foamedmapgm]
a = "foamedmapgm_local"
b = "foamedmapgm_remote"
collections = ["from a", "from b"]

[pair map26gm]
a = "map26gm_local"
b = "map26gm_remote"
collections = ["from a", "from b"]

[pair client]
a = "client_local"
b = "client_remote"
collections = ["from a", "from b"]

[storage qompass_local]
type = "filesystem"
path = "$HOME/.calendars/qompass/"
fileext = ".ics"

[storage qompass_remote]
type = "caldav"
url = "https://mail.qompass.ai/dav/calendars/map@qompass.ai/"
username = "map@qompass.ai"
# Consider using passwordcmd for secure password retrieval
# passwordcmd = ["pass", "show", "caldav/qompass"]
# auth = basic

[storage foamedmapgm_local]
type = "filesystem"
path = "$HOME/.calendars/gmail/"
fileext = ".ics"

[storage foamedmapgm_remote]
type = "caldav"
url = "https://apidata.googleusercontent.com/caldav/v2/your@gmail.com/events/"
username = "foamedmap@gmail.com"
# Consider using passwordcmd for secure password retrieval
# passwordcmd = ["pass", "show", "caldav/foamedmapgm"]
# auth = basic or oauth2 depending on server

[storage map26gm_local]
type = "filesystem"
path = "$HOME/.calendars/gmail/"
fileext = ".ics"

[storage map26gm_remote]
type = "caldav"
url = "https://apidata.googleusercontent.com/caldav/v2/matt.a.porter26@gmail.com/events/"
username = "matt.a.porter26@gmail.com"
# Consider using passwordcmd for secure password retrieval
# passwordcmd = ["pass", "show", "caldav/map26gm"]
# auth = basic or oauth2 depending on server

[storage client_local]
type = "filesystem"
path = "$HOME/.calendars/client/"
fileext = ".ics"

[storage client_remote]
type = "caldav"
url = "https://outlook.office365.com/api/v1.0/me/events/"
username = "user@company.com"
# Consider using passwordcmd for secure password retrieval
# passwordcmd = ["pass", "show", "caldav/client"]
# auth = basic or oauth2 depending on server

