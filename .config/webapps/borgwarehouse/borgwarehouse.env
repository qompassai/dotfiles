# /qompassai/dotfiles/.config/borgwarehouse/borgwarehouse.env
# Qompass AI Borg Warehouse Env Config
# Copyright (C) 2025 Qompass AI, All rights reserved
#############################################################
CONFIG_PATH="$XDG_CONFIG_HOME/webapps/borgwarehouse/config"
CRONJOB_KEY="$(pass show borghwh/cronjkey)"
DISABLE_DELETE_REPO=true
DISABLE_INTEGRATIONS=true
FQDN="$(pass show borgwh/fqdn)"
FQDN_LAN="$(pass show borgwh/fqdn_lan)"
HIDE_SSH_PORT=true
LOGS_PATH="$XDG_DATA_HOME/borgwarehouse/logs"
MAIL_REJECT_SELFSIGNED_TLS=true
MAIL_SMTP_FROM="$(pass show borgwh/smtp_from)"
MAIL_SMTP_HOST="$(pass show borgwh/smtp_host)"
MAIL_SMTP_LOGIN="$(pass show borgwh/smtp_login)"
MAIL_SMTP_PWD="$(pass show borgwh/smtp_pass)"
MAIL_SMTP_PORT="$(pass show borgwh/smtp_port)"
NEXTAUTH_SECRET="$(pass show borgwh/nextauthsec)"
NEXTAUTH_URL="$(pass show borgwh/nextauthurl)"
REPOSITORY_PATH="$XDG_DATA_HOME/borgwarehouse/repos"
SSH_HOST="$XDG_DATA_HOME/borgwarehouse/ssh_host"
SSH_PATH="$XDG_DATA_HOME/borgwarehouse/ssh"
SSH_SERVER_PORT="$(pass show borgwh/sshport)"
SSH_SERVER_PORT_LAN="$(pass show borgwh/sshs_lport)"
TMP_PATH="$XDG_RUNTIME_DIR/borgwarehouse/tmp"
WEB_SERVER_HOST='localhost'
WEB_SERVER_PORT="$(pass show borgwh/webservport)"
