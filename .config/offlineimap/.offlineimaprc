[general]
accounts = QompassAI

[Account QompassAI]
localrepository = Local
remoterepository = Remote

[Repository Local]
type = Maildir
localfolders = $XDG_DATA_HOME/mail

[Repository Remote]
type = IMAP
remotehost = mail.qompass.ai
remoteuser = map@qompass.ai
ssl = yes
sslcacertfile = /etc/ssl/certs/ca-certificates.crt
